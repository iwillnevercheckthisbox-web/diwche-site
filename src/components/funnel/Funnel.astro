    @keyframes screen-fade {
      from {
        opacity: 0;
      }
    }
  }

  .screen__inner {
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  .screen__inner--wide {
    max-width: 44rem;
  }

  .screen__eyebrow {
    font-size: var(--t-eyebrow);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--horn);
    line-height: 1;
  }

  .screen__eyebrow--alarm {
    color: var(--alarm);
  }

  .screen__title {
    font-size: var(--t-subhead);
    line-height: 1.14;
    max-width: 22ch;
  }

  .screen__title--mid {
    text-align: center;
    max-width: 24ch;
    margin-inline: auto;
  }

  .screen__lead {
    font-size: var(--t-meta);
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 54ch;
  }

  .screen__hint {
    font-size: 12px;
    color: var(--ink-3);
    margin-top: calc(var(--s-2) * -1);
  }

  /* Their own words, before the joke that answers them. Quiet and set back, so
     it reads as something being repeated rather than something being said. */
  .screen__quote {
    margin-block: var(--s-3) var(--s-2);
    padding-inline-start: var(--s-4);
    border-inline-start: 2px solid var(--rule);
    font-size: var(--t-meta);
    line-height: 1.5;
    color: var(--ink-3);
    max-width: 54ch;
  }

  /* The joke. It goes above the headline because it is the reason anyone reads
     the headline. */
  .screen__hook {
    margin-block: var(--s-3);
    font-size: var(--t-meta);
    line-height: 1.6;
    color: var(--horn);
    max-width: 54ch;
  }

  .screen__mascot {
    margin-block: var(--s-4);
    display: flex;
    justify-content: center;
  }

  .screen__mascot img {
    width: min(220px, 42vw);
    height: auto;
  }

  .rest__lead {
    margin-top: var(--s-6);
    text-align: center;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  :global([lang='fa']) .rest__lead {
    text-transform: none;
    letter-spacing: 0;
    font-size: 12px;
  }

  /* The cards shown while the read runs — everything he also does. */
  .rest {
    margin-top: var(--s-4);
    display: grid;
    /* Two across on anything wide enough. The card count varies from two to six
       depending on what was picked, and two columns is the only width that
       never leaves a single card stranded on a row of its own. */
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: var(--s-4);
    text-align: start;
  }

  /* Each one arrives on its own, seconds apart, rather than six landing in a
     single frame — the wait is thirty seconds now and a wall of cards is read
     in four. `data-in` is set by the script as each is dealt. */
  .rest__card {
    padding: var(--s-4);
    background: var(--paper-2);
    background-image: var(--sheen);
    border: 1px solid var(--rule);
    border-radius: var(--r-3);
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity var(--dur-slow) var(--ease-out),
      transform var(--dur-slow) var(--ease-out);
  }

  .rest__card[data-in] {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .rest__card {
      transform: none;
    }
  }

  .rest__label {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--horn);
  }

  .rest__title {
    margin-top: var(--s-2);
    font-family: var(--font-display);
    font-size: 17px;
    line-height: 1.25;
    color: var(--ink);
  }

  .rest__text {
    margin-top: var(--s-2);
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-3);
  }

  /* The capture under the wait is scenery, not the subject. */
  .screen__shot--quiet {
    opacity: 0.55;
  }

  .screen__shot {
    margin-block: var(--s-2);
  }

  /*
   * Fitting a screen into a laptop.
   *
   * On a 13" MacBook and an iPad in landscape the walk overflowed by 150–280px
   * on every screen after the first — enough that the button was always below
   * the fold and the whole thing read as a web page rather than as a card being
   * dealt. Measured, not guessed: `need` against the stage's `clientHeight` at
   * 1440×800 and 1180×820.
   *
   * The height query rather than a width one is the point. A short window is
   * the problem; a narrow one is not, and a phone should keep the roomy
   * spacing it already has. Only screens that carry a capture are squeezed,
   * because the capture is most of the overflow.
   */
  @media (min-width: 860px) and (max-height: 950px) {
    .stage {
      padding-block: var(--s-4);
    }

    .screen__inner {
      gap: var(--s-2);
    }

    .screen__title {
      font-size: clamp(1.4rem, 1rem + 1.6vw, 2rem);
    }

    .screen__lead,
    .screen__quote,
    .screen__hook {
      font-size: 14px;
      line-height: 1.55;
    }

    /* The capture takes whatever room is left rather than a fixed aspect. It is
       evidence that the product exists, not something anyone reads. */
    .screen__shot {
      margin-block: 0;
      max-height: 32vh;
      overflow: hidden;
      border-radius: var(--r-3);
    }

    .screen__shot :global(img) {
      max-height: 28vh;
      object-fit: cover;
      object-position: top center;
    }

    .screen__mascot {
      margin-block: 0;
    }

    .screen__mascot img {
      width: min(104px, 14vh);
    }

    .screen__hint {
      font-size: 12px;
    }

    .option {
      padding-block: var(--s-2);
    }

    .options {
      gap: var(--s-2);
    }

    /* The quote is context for the joke. On a short screen the joke can carry
       itself, and the two together cost a whole option's worth of height. */
    .screen__quote {
      display: none;
    }

    .option__sub {
      font-size: 12px;
    }
  }

  /*
   * Where it cannot fit, say so.
   *
   * The wait carries up to six cards and the report carries five findings; no
   * amount of squeezing makes either a single screen, and squeezing them until
   * they fit would make them unreadable. A fade at the bottom edge turns "this
   * is cut off" into "there is more below", which is the honest version.
   */
  .stage::after {
    content: '';
    position: sticky;
    bottom: 0;
    display: block;
    height: 56px;
    margin-top: -56px;
    pointer-events: none;
    background: linear-gradient(to top, var(--paper), transparent);
    opacity: var(--more, 0);
    transition: opacity var(--dur) var(--ease-out);
  }

  /* ---- Options ------------------------------------------------------------ */

  .options {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  .options--tight {
    gap: var(--s-2);
  }

  .option {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-4) var(--s-4);
    text-align: start;
    background: var(--paper-2);
    background-image: var(--sheen);
    border: 1px solid var(--rule);
    border-radius: var(--r-3);
    transition:
      transform var(--dur-fast) var(--ease-out),
      border-color var(--dur) ease,
      background-color var(--dur) ease;
  }

  .option:active {
    transform: scale(0.98);
  }

  /* Champagne marks the choice — a border where a mark is meant to be noticed,
     which is the one place DNA §4 allows a coloured hairline. */
  .option[data-chosen] {
    border-color: var(--horn);
    background-color: var(--paper-4);
  }

  .option__icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--r-2);
    background: var(--paper-3);
    border: 1px solid var(--rule-soft);
    color: var(--accent-soft);
  }

  .option[data-chosen] .option__icon {
    color: var(--horn);
    border-color: var(--horn-deep);
  }

  .option__icon svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .option__text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .option__label {
    font-size: var(--t-body);
    line-height: 1.3;
  }

  .option__sub {
    font-size: 12px;
    color: var(--ink-3);
    line-height: 1.4;
  }

  .option__tick {
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    border: 1px solid var(--rule);
    color: var(--paper);
    opacity: 0;
    transition: opacity var(--dur) ease;
  }

  .option[data-chosen] .option__tick {
    opacity: 1;
    background: var(--horn);
    border-color: var(--horn);
  }

  .option__tick svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* A single-answer screen advances on tap, so a tick that lingers is a lie
     about what is still selectable. */
  .screen:not([data-multi]) .option__tick {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .option:hover {
      border-color: var(--horn-deep);
      background-color: var(--paper-4);
    }

    .bar__back:hover {
      color: var(--ink);
    }
  }

  .btn--wide {
    justify-content: center;
    width: 100%;
    padding-block: 0.85rem;
    margin-top: var(--s-2);
  }

  .btn--wide:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .field__error {
    font-size: 12px;
    color: var(--alarm);
  }

  /* ---- The handle ---------------------------------------------------------- */

  .start {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  .start__field {
    display: flex;
    align-items: center;
    padding-inline: var(--s-4);
    background: var(--paper-2);
    background-image: var(--sheen);
    border: 1px solid var(--rule);
    border-radius: var(--r-3);
    transition: border-color var(--dur) ease;
  }

  .start__field:focus-within {
    border-color: var(--accent-soft);
  }

  .start__at {
    color: var(--ink-3);
    font-size: var(--t-lead);
    line-height: 1;
  }

  .start__input {
    flex: 1;
    min-width: 0;
    padding: 0.85rem 0.25rem;
    background: none;
    border: none;
    color: var(--ink);
    font: inherit;
    font-size: var(--t-lead);
  }

  .start__input:focus {
    outline: none;
  }

  .start__input::placeholder,
  .start__area::placeholder {
    color: var(--ink-3);
  }

  .start__input--boxed {
    width: 100%;
    padding: 0.8rem 0.9rem;
    background: var(--paper-3);
    border: 1px solid var(--rule);
    border-radius: var(--r-3);
    font-size: var(--t-meta);
  }

  .start__input--boxed:focus {
    outline: none;
    border-color: var(--accent-soft);
  }

  .start__area {
    width: 100%;
    padding: 0.8rem 0.9rem;
    background: var(--paper-3);
    border: 1px solid var(--rule);
    border-radius: var(--r-3);
    color: var(--ink);
    font: inherit;
    font-size: var(--t-meta);
    line-height: 1.5;
    resize: vertical;
  }

  .start__area:focus {
    outline: none;
    border-color: var(--accent-soft);
  }

  /* ---- Analysing ----------------------------------------------------------- */

  .ring {
    position: relative;
    width: 9.5rem;
    height: 9.5rem;
    margin-inline: auto;
  }

  .ring svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .ring circle {
    fill: none;
    stroke-width: 5;
    stroke-linecap: round;
  }

  .ring__track {
    stroke: var(--rule-soft);
  }

  .ring__fill {
    stroke: var(--accent-soft);
    stroke-dasharray: 327;
    stroke-dashoffset: 327;
    transition: stroke-dashoffset 900ms var(--ease-in-out);
  }

  .ring__pct {
    position: absolute;
    inset: 0;
    /* Flex, not grid: in a grid the bare "%" text node becomes its own item and
       sits under the number instead of beside it. */
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-variation-settings: var(--display-axes);
    font-size: 1.75rem;
    letter-spacing: -0.02em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .screen__tip {
    text-align: center;
    max-width: 40ch;
    margin-inline: auto;
    font-size: var(--t-meta);
    color: var(--ink-3);
    transition: opacity var(--dur) var(--ease-out);
  }

  .screen__tip[data-fading] {
    opacity: 0;
  }

  /* Said once the read has finished and the wait has not. Champagne, because it
     is good news, and small, because it is not the point of the screen. */
  .screen__tip--ready {
    color: var(--horn);
  }

  /* ---- Findings ------------------------------------------------------------ */

  /* The page he read, at the top of what he found. */
  .who {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    margin-block: var(--s-4) var(--s-5);
    padding: var(--s-4);
    background: var(--paper-2);
    background-image: var(--sheen);
    border: 1px solid var(--rule);
    border-radius: var(--r-3);
    text-align: start;
  }

  .who__face {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--paper-4);
    border: 1px solid var(--rule);
  }

  .who__handle {
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.2;
    color: var(--ink);
    /* A handle is a name, not prose: it reads left to right in every language. */
    unicode-bidi: isolate;
  }

  .who__counts {
    margin-top: 2px;
    display: flex;
    gap: var(--s-4);
    font-size: 12px;
    color: var(--ink-3);
  }

  .who__counts b {
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  /* ---- The report ---------------------------------------------------------- */

  .report {
    display: grid;
    gap: var(--s-5);
  }

  .block {
    display: grid;
    gap: var(--s-3);
  }

  .block__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2);
    flex-wrap: wrap;
    border-block-end: 1px solid var(--rule);
    padding-block-end: var(--s-2);
  }

  .block__title {
    font-family: var(--font-display);
    font-variation-settings: var(--display-axes);
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  /* One word, and it is allowed to be loud. A verdict that reads like the label above it is a
     verdict nobody registers, which is the whole reason the old page said nothing. */
  .block__verdict {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink-3);
  }

  .block__verdict[data-verdict='good'] {
    color: var(--verdict-good);
  }

  .block__verdict[data-verdict='weak'] {
    color: var(--verdict-weak);
  }

  .block__verdict[data-verdict='bad'],
  .block__verdict[data-verdict='dead'] {
    color: var(--verdict-bad);
  }

  /* ---- The chart ----------------------------------------------------------- */

  .chart {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-4);
    background: var(--paper-2);
    background-image: var(--sheen);
    border: 1px solid var(--rule);
    border-radius: var(--r-3);
  }

  .chart__title {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /*
   * The plot.
   *
   * Everything inside it is built by readChart.ts at runtime, and a scoped rule never reaches
   * an element Astro did not render — which is how the old `svg { height }`, `.chart__month`
   * and `.chart__gap` rules styled nothing at all. So the selectors below cross into the
   * drawing with :global, and the drawing sets its own colours and sizes on the elements, so
   * that it stays legible even if one of these ever stops matching.
   */
  .chart__plot {
    position: relative;
    min-width: 0;
  }

  .chart__plot :global(.chart__svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    touch-action: pan-y;
  }

  .chart__plot :global(.chart__svg:focus-visible) {
    outline-offset: 4px;
  }

  /* Pointing at one post quiets the rest, which reads the same on either theme. */
  .chart__plot :global(.chart__mark) {
    transition: opacity var(--dur-fast) ease;
  }

  .chart__plot :global(.chart__svg[data-hovering] .chart__mark:not([data-active])) {
    opacity: 0.4;
  }

  .chart__plot :global(.chart__tip) {
    position: absolute;
    top: 0;
    z-index: 2;
    display: grid;
    gap: 1px;
    padding: 6px 10px;
    background: var(--paper-4);
    border: 1px solid var(--rule);
    border-radius: var(--r-2);
    font-size: 12px;
    line-height: 1.4;
    white-space: nowrap;
    pointer-events: none;
    text-align: start;
  }

  /* The figure leads, the date and format follow it. */
  .chart__plot :global(.chart__tip strong) {
    font-weight: 600;
    color: var(--ink);
  }

  .chart__plot :global(.chart__tip span) {
    color: var(--ink-2);
  }

  .chart__plot :global(.chart__legend) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-4);
    margin-top: var(--s-2);
    padding: 0;
    list-style: none;
    font-size: 12px;
    color: var(--ink-2);
  }

  .chart__plot :global(.chart__legend li) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .chart__plot :global(.chart__legend [data-swatch]) {
    width: 10px;
    height: 10px;
    border-radius: 2px;
  }

  .chart__plot :global(.chart__legend [data-swatch='hidden']) {
    border: 1.5px solid var(--ink-2);
  }

  /* The same ring that sits over a pinned bar. */
  .chart__plot :global(.chart__legend [data-swatch='pinned']) {
    width: 8px;
    height: 8px;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
  }

  /* What the chart covers — a caption, not a finding. Direction comes from the page. */
  .chart__plot :global(.chart__window) {
    margin: var(--s-2) 0 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    text-align: start;
  }

  .chart__note {
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-3);
  }

  .facts,
  .topics {
    display: grid;
    gap: var(--s-3);
  }

  @media (min-width: 46rem) {
    .facts,
    .topics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .fact {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding: var(--s-4);
    background: var(--paper-2);
    background-image: var(--sheen);
    border: 1px solid var(--rule);
    border-inline-start: 2px solid var(--horn);
    border-radius: var(--r-3);
  }

  .fact__label {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    line-height: 1;
  }

  .fact__value {
    font-family: var(--font-display);
    font-variation-settings: var(--display-axes);
    font-size: 1.75rem;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .fact__text {
    font-size: var(--t-meta);
    line-height: 1.5;
    color: var(--ink-2);
  }

  /* A locked card keeps its label and shows a shape where the figure would
     be. The shape is blurred, so it reads as something held back rather than
     as something missing — and there is no text under it to lift. */
  .fact[data-locked] .fact__value,
  .fact[data-locked] .fact__text,
  .topic[data-locked] .topic__hook {
    display: none;
  }

  .fact__held {
    white-space: nowrap;
    color: var(--horn-deep);
  }

  .topic__title .fact__held {
    font-family: var(--font-body, inherit);
    font-variation-settings: normal;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-inline-start: 0.4em;
  }

  .ghost {
    display: grid;
    gap: var(--s-2);
    filter: blur(6px);
    user-select: none;
    pointer-events: none;
  }

  .ghost__value,
  .ghost__line {
    display: block;
    background: var(--ink-3);
    border-radius: 4px;
    opacity: 0.55;
  }

  .ghost__value {
    width: 4ch;
    height: 1.75rem;
    margin-bottom: var(--s-1);
  }

  .ghost__line {
    width: 100%;
    height: 0.8em;
  }

  .ghost__line--short {
    width: 62%;
  }

  .rivals {
    display: grid;
    gap: var(--s-2);
    margin-block-start: var(--s-4);
  }

  /* ---- The field, and the cost of waiting (starter branch) ------------------ */

  .field {
    display: grid;
    gap: var(--s-3);
  }

  .field__title,
  .size__title {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    line-height: 1;
  }

  .field__list {
    display: grid;
    gap: var(--s-3);
  }

  @media (min-width: 46rem) {
    .field__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .page {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding: var(--s-3) var(--s-4);
    background: var(--paper-2);
    background-image: var(--sheen);
    border: 1px solid var(--rule);
    border-radius: var(--r-3);
  }

  .page__handle {
    font-family: var(--font-display);
    font-variation-settings: var(--display-axes);
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .page__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-2) var(--s-3);
    margin: 0;
  }

  .page__stats div {
    display: grid;
    gap: 2px;
  }

  .page__stats dt {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    line-height: 1.2;
  }

  .page__stats dd {
    margin: 0;
    font-size: var(--t-meta);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }

  .waiting,
  .rewards {
    font-size: var(--t-meta);
    line-height: 1.5;
    color: var(--ink-2);
    padding: var(--s-3) var(--s-4);
    border-inline-start: 2px solid var(--horn);
    background: var(--paper-2);
    border-radius: var(--r-2);
  }

  /* ---- What a page this size can do ------------------------------------------ */

  .size {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-5);
  }

  .size__list {
    display: grid;
    gap: var(--s-2);
  }

  @media (min-width: 46rem) {
    .size__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .size__line {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    background: var(--paper-2);
    background-image: var(--sheen);
    border: 1px solid var(--rule);
    border-inline-start: 2px solid var(--horn);
    border-radius: var(--r-2);
  }

  .size__value {
    font-family: var(--font-display);
    font-variation-settings: var(--display-axes);
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .size__text {
    font-size: var(--t-meta);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .meter {
    position: relative;
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-1);
  }

  .meter__track {
    height: 6px;
    background: var(--paper-3);
    border: 1px solid var(--rule-soft);
    border-radius: 3px;
    overflow: hidden;
  }

  .meter__fill {
    display: block;
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--accent-dim), var(--accent-soft));
    transition: width var(--dur-slow) var(--ease-out);
  }

  .meter__mark {
    position: absolute;
    top: 0;
    inset-inline-start: 0;
    width: 1px;
    height: 8px;
    background: var(--horn);
  }

  .meter__legend {
    font-size: 11px;
    color: var(--ink-3);
    line-height: 1.3;
  }

  .topic {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding: var(--s-4);
    background: var(--paper-2);
    background-image: var(--sheen);
    border: 1px solid var(--rule);
    border-radius: var(--r-3);
  }

  .topic__format {
    justify-self: start;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--horn-soft);
    padding: 3px 8px;
    border: 1px solid var(--tag-border);
    background: var(--tag-bg);
    border-radius: var(--r-1);
    line-height: 1.4;
  }

  .topic__title {
    font-family: var(--font-display);
    font-variation-settings: var(--display-axes);
    font-size: 1.2rem;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .topic__hook {
    font-size: var(--t-meta);
    color: var(--ink-2);
    line-height: 1.5;
  }

  /* ---- Lead and plan -------------------------------------------------------- */

  .lead {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-3);
    padding: var(--s-5);
    background: var(--paper-2);
    background-image: var(--sheen);
    border: 1px solid var(--rule);
    border-radius: var(--r-3);
  }

  .lead__title {
    font-family: var(--font-display);
    font-variation-settings: var(--display-axes);
    font-size: 1.3rem;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  /* On the result screen the teaser is no longer a bargain, so it sits on its
     own rather than at the top of a form. */
  .lead__title--open {
    margin-top: var(--s-5);
  }

  .lead__note {
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-3);
    text-align: center;
  }

  .lead__consent {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-2);
    align-items: start;
    font-size: 12px;
    color: var(--ink-3);
    line-height: 1.45;
  }

  .proj {
    padding: var(--s-5);
    background: var(--paper-2);
    background-image: var(--sheen);
    border: 1px solid var(--rule);
    border-radius: var(--r-3);
  }

  .gain {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-5);
  }

  .span {
    margin-block: var(--s-6) var(--s-5);
  }

  .span__title {
    margin: 0 0 var(--s-3);
    font-size: var(--t-12);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .span__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .span__cell {
    display: grid;
    gap: 2px;
    padding: var(--s-3);
    border: 1px solid var(--rule);
    border-radius: var(--r-2);
  }

  /* The year is the argument. The other two are the reason to believe it. */
  .span__cell:last-child {
    border-color: var(--horn);
  }

  .span__when {
    margin: 0;
    font-size: var(--t-12);
    color: var(--ink-3);
  }

  .span__total {
    margin: 0;
    font-size: var(--t-22);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .span__new {
    margin: 0;
    font-size: var(--t-12);
    color: var(--horn);
    font-variant-numeric: tabular-nums;
  }

  .span__track {
    margin-top: var(--s-2);
    height: 3px;
    border-radius: 999px;
    background: var(--rule);
    overflow: hidden;
  }

  .span__fill {
    height: 100%;
    border-radius: 999px;
    background: var(--horn);
    transform: scaleX(var(--grown, 0));
    transform-origin: left center;
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global([dir='rtl']) .span__fill {
    transform-origin: right center;
  }

  @media (prefers-reduced-motion: reduce) {
    .span__fill { transition: none; }
  }

  @media (max-width: 560px) {
    .span__list { grid-template-columns: 1fr; }
    .span__cell { grid-template-columns: 1fr auto; align-items: baseline; }
    .span__track { grid-column: 1 / -1; }
  }

  .gain__label {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* A fixed-height track with the fill growing up from the baseline, so the two
     columns are read against each other rather than against the card edge. */
  .gain__track {
    display: flex;
    align-items: flex-end;
    width: 100%;
    max-width: 92px;
    height: 84px;
    margin-top: var(--s-3);
    border-bottom: 1px solid var(--rule);
  }

  .gain__fill {
    width: 100%;
    /* Full height, then scaled to the share it represents. The floor lives in
       the script, so an honest near-zero still draws something. */
    height: 100%;
    background: var(--rule-soft);
    border-top: 2px solid var(--rule);
    transform: scaleY(var(--grown, 0));
    transform-origin: bottom;
    transition: transform 720ms var(--ease-out);
  }

  /* A tint and a bright edge, not a slab of paint: the number is what the eye
     should land on, and the champagne is only there to say which one is which. */
  .gain__col--then .gain__fill {
    background: color-mix(in srgb, var(--horn) 14%, transparent);
    border-top-color: var(--horn);
  }

  .gain__amount {
    margin-top: var(--s-3);
    font-family: var(--font-display);
    font-size: 30px;
    line-height: 1.1;
    color: var(--ink-1, var(--ink));
  }

  .gain__col--then .gain__amount {
    color: var(--horn);
  }

  .gain__pace {
    margin-top: 2px;
    font-size: 12px;
    color: var(--ink-3);
  }

  .moves {
    margin-top: var(--s-5);
    padding: var(--s-4) 0 0;
    border-top: 1px solid var(--rule-soft);
    display: grid;
    gap: var(--s-3);
    list-style: none;
  }

  .moves__item {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: var(--s-3);
    align-items: baseline;
    font-size: var(--t-meta);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .moves__item::before {
    content: '';
    width: 6px;
    height: 6px;
    margin-inline-start: 6px;
    border-radius: 50%;
    background: var(--horn-soft);
    transform: translateY(-2px);
  }

  .ways {
    margin-top: var(--s-5);
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: var(--s-3);
    font-size: 12px;
    color: var(--ink-3);
  }

  .ways__link {
    font: inherit;
    color: var(--ink-3);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 3px;
  }

  .ways__link:hover {
    color: var(--ink-2);
    text-decoration-color: var(--horn);
  }

  .proj__headline {
    margin-bottom: var(--s-4);
    font-family: var(--font-display);
    font-size: clamp(20px, 3vw, 26px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .proj__working {
    margin-top: var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule-soft);
    font-size: 12px;
