---
/**
 * The read, as a funnel.
 *
 * One screen at a time, full viewport, tap an answer and it advances. Two
 * questions decide the rest of the walk: the first splits the audience, the
 * second asks what is in the way — and only the things someone actually admits
 * to become screens. So the walk is seven to ten screens long depending on the
 * answers, and every screen is rendered here at build time while
 * `src/scripts/funnel.ts` decides which of them are in the active set.
 *
 * No English lives in this file. Every string comes from a `FunnelCopy`, which
 * is what lets the same component serve `/read` and `/fa/read` — and what makes
 * a missing Persian string a compile error rather than an English word on a
 * Persian screen.
 */
import Screenshot from '../Screenshot.astro';
import { ICONS } from './icons';
import { EN } from './copy.en';
import type { FunnelCopy } from './types';
import LangSwitch from '../LangSwitch.astro';
import { isLocale, type Locale } from '../../lib/direction';

interface Props {
  /** False until the backend serves `/api/public/*`. Only changes what is said. */
  connected?: boolean;
  copy?: FunnelCopy;
}

const { connected = false, copy = EN } = Astro.props;
const screens = copy.screens;

/**
 * The language of this walk.
 *
 * The answers survive a switch untouched: they are stored as values like
 * `active` and `ideas`, which are the same word in every language, so someone
 * who switches half-way keeps their place rather than starting again.
 */
const here: Locale = isLocale(copy.locale) ? (copy.locale as Locale) : 'en';

/**
 * The step total is decided at runtime, not here.
 *
 * It used to be `screens.length` baked into the markup, which was true only
 * while every visitor walked every screen. Now the denominator depends on how
 * many blockers someone picks, so the bar is filled in by the script and this
 * is only a starting value that is replaced before anyone sees it.
 */
const alwaysShown = screens.filter((s) => s.kind !== 'error' && !s.showIf).length;
---

<div
  class="funnel"
  data-funnel
  data-locale={copy.locale}
  data-connected={connected ? 'yes' : 'no'}
>
  {/* Everything the script says at runtime, shipped as data rather than
      imported — so one script serves both languages and each page carries only
      its own strings. */}
  <script
    type="application/json"
    data-copy
    set:html={JSON.stringify({
      ui: copy.ui,
      runtime: copy.runtime,
      result: copy.result,
      plan: { sizeTitle: copy.plan.sizeTitle },
    })}
  />
  {!connected && <p class="preview">{copy.preview}</p>}

  <!-- ================================================================== BAR -->
  <header class="bar">
    {/* Named, not just drawn. A bare chevron in the corner of a stepper is a
        control people do not find: the reported complaint was that there was no
        way back between questions, and there was — it was 20px of outline with
        nothing beside it. The word rides along on anything wider than a phone,
        and the arrow keeps its own accessible name either way. */}
    <button class="bar__back" type="button" data-back aria-label={copy.bar.back}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 19l-7-7 7-7" /></svg>
      <span class="bar__back-word">{copy.bar.back}</span>
    </button>
    <div class="bar__track" role="presentation"><i data-progress></i></div>
    <p class="bar__count" dir="ltr"><b data-step-now>1</b> / <b data-step-total>{alwaysShown}</b></p>
    {/* The door, on every screen of the walk. Nobody should have to finish this
        to leave it, and closing the tab is what people do instead. */}
    <a class="bar__home" href={here === 'en' ? '/' : `/${here}/`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11l8-7 8 7v8a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z" /></svg>
      <span class="bar__home-word">{copy.bar.home}</span>
    </a>
    <div class="bar__lang"><LangSwitch locale={here} path={Astro.url.pathname} label={copy.ui.language} compact /></div>
  </header>

  <!-- ============================================================== SCREENS -->
  <main class="stage">
    {
      screens.map((screen) => (
        <section
          class="screen"
          data-screen={screen.id}
          data-kind={screen.kind}
          data-when={screen.showIf ? `${screen.showIf.screen}:${screen.showIf.is}` : undefined}
          hidden
        >
          {screen.kind === 'question' && (
            <div class:list={['screen__inner', screen.shot && 'screen__inner--wide']}>
              <p class="screen__eyebrow">{screen.eyebrow}</p>
              {/* A second wording of the same question, chosen at runtime from
                  the answer to the first one. */}
              <h1
                class="screen__title"
                data-title
                data-title-when={screen.titleWhen ? JSON.stringify(screen.titleWhen) : undefined}
              >
                {screen.title}
              </h1>
              {screen.hint && <p class="screen__hint">{screen.hint}</p>}

              {screen.shot && (
                <div class="screen__mascot">
                  <img src={screen.shot.src} alt={screen.shot.alt} width="360" height="360" loading="eager" />
                </div>
              )}

              <div class:list={['options', screen.options.length > 4 && 'options--tight']}>
                {screen.options.map((o) => (
                  <button
                    class="option"
                    type="button"
                    data-option={o.value}
                    aria-pressed={screen.multi ? 'false' : undefined}
                  >
                    <span class="option__icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" set:html={ICONS[o.icon]} />
                    </span>
                    <span class="option__text">
                      <span class="option__label">{o.label}</span>
                      {o.sub && <span class="option__sub">{o.sub}</span>}
                    </span>
                    <span class="option__tick" aria-hidden="true">
                      <svg viewBox="0 0 24 24"><path d="m5 13 4 4L19 7" /></svg>
                    </span>
                  </button>
                ))}
              </div>
              {screen.multi && (
                <button class="btn btn--wide" type="button" data-continue disabled>
                  {copy.ui.continue}
                </button>
              )}
            </div>
          )}

          {screen.kind === 'insight' && (
            <div class="screen__inner screen__inner--wide">
              <p class="screen__eyebrow">{screen.eyebrow}</p>
              {/* Their own words first. The joke only lands because the sentence
                  above it is the one they just picked. */}
              {screen.quote && <p class="screen__quote">“{screen.quote}”</p>}
              <p class="screen__hook">{screen.hook}</p>
              <h1 class="screen__title">{screen.title}</h1>
              <p class="screen__lead">{screen.lead}</p>
              <div class="screen__shot">
                <Screenshot
                  src={screen.shot.src}
                  alt={screen.shot.alt}
                  width={1280}
                  height={800}
                  label={screen.shot.label}
                />
              </div>
              <button class="btn btn--wide" type="button" data-next>
                {copy.ui.next}
              </button>
            </div>
          )}

          {screen.kind === 'start' && (
            <div class="screen__inner screen__inner--wide">
              <p class="screen__eyebrow">{screen.eyebrow}</p>
              <p class="screen__hook">{screen.hook}</p>
              <h1 class="screen__title">{screen.title}</h1>
              <p class="screen__lead">{screen.lead}</p>
              <div class="screen__shot">
                <Screenshot
                  src={screen.shot.src}
                  alt={screen.shot.alt}
                  width={1280}
                  height={800}
                  label={screen.shot.label}
                />
              </div>

              <form class="start" data-start-form data-field={screen.field} novalidate>
                {screen.field === 'handle' ? (
                  <div class="start__field">
                    <span class="start__at" aria-hidden="true">@</span>
                    <label class="sr" for={`in-${screen.id}`}>{screen.title}</label>
                    <input
                      class="start__input"
                      id={`in-${screen.id}`}
                      data-handle
                      type="text"
                      autocomplete="off"
                      autocapitalize="off"
                      autocorrect="off"
                      spellcheck="false"
                      maxlength="30"
                      placeholder={screen.placeholder}
                    />
                  </div>
                ) : (
                  <div>
                    <label class="sr" for={`in-${screen.id}`}>{screen.title}</label>
                    <textarea
                      class="start__area"
                      id={`in-${screen.id}`}
                      data-idea
                      rows="3"
                      maxlength="400"
                      placeholder={screen.placeholder}
                    />
                  </div>
                )}
                <p class="field__error" data-start-error hidden />
                <button class="btn btn--wide" type="submit">{screen.cta}</button>
              </form>
            </div>
          )}

          {screen.kind === 'rivals' && (
            <div class="screen__inner">
              <p class="screen__eyebrow">{screen.eyebrow}</p>
              <h1 class="screen__title">{screen.title}</h1>
              <p class="screen__lead">{screen.lead}</p>

              {/* Three, because each one is a call to Instagram made while somebody waits, and
                  because nobody has more than three pages they genuinely measure themselves
                  against. Skipping is a first-class answer, not a way out. */}
              <form class="rivals" data-rivals-form novalidate>
                {[0, 1, 2].map((i) => (
                  <div class="start__field">
                    <span class="start__at" aria-hidden="true">@</span>
                    <label class="sr" for={`rival-${i}`}>{screen.title}</label>
                    <input
                      class="start__input"
                      id={`rival-${i}`}
                      data-rival
                      type="text"
                      autocomplete="off"
                      autocapitalize="off"
                      autocorrect="off"
                      spellcheck="false"
                      maxlength="30"
                      placeholder={i === 0 ? screen.placeholder : ''}
                    />
                  </div>
                ))}
                <button class="btn btn--wide" type="submit">{screen.cta}</button>
                <button class="btn btn--quiet btn--wide" type="button" data-rivals-skip>
                  {screen.skip}
                </button>
              </form>
            </div>
          )}

          {screen.kind === 'email' && (
            <div class="screen__inner">
              <p class="screen__eyebrow">{copy.email.eyebrow}</p>
              <h1 class="screen__title">{copy.email.title}</h1>
              <p class="screen__lead">{copy.email.lead}</p>

              {/* The same form the result screen used to carry, moved to where it
                  belongs. Nothing is held back behind it any more, so it is asked
                  once, plainly, and the read that follows is shown whole. */}
              <form class="lead" data-email-form novalidate>
                <label class="sr" for="walk-email">{copy.email.label}</label>
                <input
                  class="start__input start__input--boxed"
                  id="walk-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  inputmode="email"
                  placeholder={copy.email.placeholder}
                  required
                />
                <label class="lead__consent">
                  <input type="checkbox" data-email-consent />
                  <span>{copy.email.consent}</span>
                </label>
                <p class="field__error" data-email-error hidden />
                <button class="btn btn--wide" type="submit" data-email-submit>
                  {copy.email.cta}
                </button>
                <p class="lead__note">{copy.email.note}</p>
              </form>
            </div>
          )}

          {screen.kind === 'verify' && (
            <div class="screen__inner">
              <p class="screen__eyebrow">{copy.verify.eyebrow}</p>
              <h1 class="screen__title">{copy.verify.title}</h1>
              <p class="screen__lead">{copy.verify.lead}</p>

              <ol class="proof__steps">
                <li data-proof-step="follow">{copy.verify.steps.follow}</li>
                <li data-proof-step="send">{copy.verify.steps.send}</li>
                <li data-proof-step="wait">{copy.verify.steps.wait}</li>
              </ol>

              <div class="proof__code" data-proof-code-wrap>
                <output class="proof__digits" data-proof-code aria-live="polite">······</output>
                <button class="btn btn--quiet" type="button" data-copy-code>{copy.ui.copy}</button>
              </div>

              <a class="btn btn--wide" data-proof-link href="https://instagram.com" target="_blank" rel="noopener">
                {copy.verify.open}
              </a>

              <p class="proof__status" data-proof-status="waiting">{copy.verify.waiting}</p>
              <p class="proof__status proof__status--ok" data-proof-status="verified" hidden>{copy.verify.verified}</p>
              <p class="proof__status proof__status--warn" data-proof-status="wrong_account" hidden>{copy.verify.wrongAccount}</p>
              <p class="proof__status proof__status--warn" data-proof-status="not_following" hidden>{copy.verify.notFollowing}</p>
              <p class="proof__status proof__status--warn" data-proof-status="expired" hidden>{copy.verify.expired}</p>
              <p class="proof__status proof__status--warn" data-proof-status="unavailable" hidden>{copy.verify.unavailable}</p>

              <p class="proof__ways">
                <button class="linklike" type="button" data-proof-again hidden>{copy.verify.again}</button>
                <button class="linklike" type="button" data-proof-change>{copy.verify.change}</button>
              </p>
            </div>
          )}

          {screen.kind === 'analyzing' && (
            <div class="screen__inner screen__inner--wide">
              <div class="ring" role="presentation">
                <svg viewBox="0 0 120 120">
                  <circle class="ring__track" cx="60" cy="60" r="52" />
                  <circle class="ring__fill" cx="60" cy="60" r="52" data-ring />
                </svg>
                <p class="ring__pct"><b data-pct>0</b>%</p>
              </div>
              <h1 class="screen__title screen__title--mid" data-analyzing-line>
                {copy.analyzing.line}
              </h1>
              <p class="screen__tip">{copy.analyzing.lead}</p>
              {/* Said once the work is finished but the wait is not. The read is
                  done and nothing is being hidden; pretending otherwise would be
                  the one dishonest line on the page. */}
              <p class="screen__tip screen__tip--ready" data-analyzing-ready hidden>
                {copy.runtime.ready}
              </p>

              {/* Whatever they did not pick, plus the two nobody is asked about.
                  The wait is the only place left to say these, and it is long
                  enough now that the handle is asked at the end.

                  They arrive one at a time rather than all at once: six cards
                  dealt in a single frame are six cards a reader has finished
                  with in four seconds, and the wait is thirty. */}
              <p class="rest__lead">{copy.analyzing.cardsLead}</p>
              <div class="rest" data-rest />

              <div class="screen__shot screen__shot--quiet">
                <Screenshot
                  src={copy.analyzing.shot.src}
                  alt={copy.analyzing.shot.alt}
                  width={1280}
                  height={800}
                  label={copy.analyzing.shot.label}
                />
              </div>
              <script type="application/json" data-features set:html={JSON.stringify(copy.features)} />
            </div>
          )}

          {screen.kind === 'result' && (
            <div class="screen__inner screen__inner--wide">
              <p class="screen__eyebrow">{copy.result.eyebrow}</p>

              {/* Their own page, before anything is claimed about it. A handle,
                  a face and two counts they can check in three seconds does more
                  for trust than any sentence we could write. */}
              <figure class="who" data-who hidden>
                <img class="who__face" data-who-avatar alt="" width="72" height="72" />
                <figcaption class="who__text">
                  <p class="who__handle" data-who-handle dir="ltr"></p>
                  <p class="who__counts">
                    <span><b data-who-followers></b> {copy.result.followers}</span>
                    <span><b data-who-posts></b> {copy.result.posts}</span>
                  </p>
                </figcaption>
              </figure>

              <h1 class="screen__title" data-result-headline />

              {/* The evidence, before any of the claims. One bar per post, by date. Never held
                  back: holding the evidence while showing the conclusions is the wrong way
                  round, and it is the only part of the page a reader can check against their
                  own grid. */}
              <section class="chart" data-chart hidden>
                <p class="chart__title">{copy.result.chartTitle}</p>
                <div class="chart__plot" data-chart-plot />
                <p class="chart__note">{copy.result.chartNote}</p>
              </section>

              {/* The report itself, one section per heading, drawn from the template below. */}
              <div class="report" data-sections />

              <div class="facts" data-facts hidden />

              {/* The starter branch. No page was read, so what is shown is the
                  field the idea is walking into: the pages already working it,
                  the angles he would open with, and what waiting costs. */}
              <section class="field" data-field hidden>
                <p class="field__title">{copy.result.fieldTitle}</p>
                <div class="field__list" data-field-list />
              </section>
              <div class="topics" data-topics hidden />
              <p class="waiting" data-waiting hidden />
              <p class="rewards" data-rewards hidden />

              {/* The way on, for a reader who left an address at the end of the
                  questionnaire — which is everybody who got here the ordinary
                  way. The form below is what is left when that did not happen. */}
              <p class="lead__title lead__title--open" data-result-teaser hidden>{copy.result.teaser}</p>
              <button class="btn btn--wide" type="button" data-onward hidden>{copy.result.onward}</button>

              <form class="lead" data-lead-form novalidate hidden>
                <p class="lead__title">{copy.result.teaser}</p>
                <label class="sr" for="email">{copy.result.emailLabel}</label>
                <input
                  class="start__input start__input--boxed"
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  inputmode="email"
                  placeholder={copy.result.placeholder}
                  required
                />
                <label class="lead__consent">
                  <input type="checkbox" data-consent />
                  <span>{copy.result.consent}</span>
                </label>
                <p class="field__error" data-lead-error hidden />
                <button class="btn btn--wide" type="submit" data-lead-submit>
                  {copy.result.cta}
                </button>
              </form>
            </div>
          )}

          {screen.kind === 'plan' && (
            <div class="screen__inner screen__inner--wide">
              <p class="screen__eyebrow">{copy.plan.eyebrow}</p>
              <h1
                class="screen__title"
                data-plan-headline
                data-plan-headline-starter={copy.plan.starterHeadline}
              >
                {copy.plan.headline}
              </h1>

              <p class="screen__lead" data-projection-none hidden>{copy.runtime.noProjection}</p>

              <div class="proj" data-projection hidden>
                {/* The projection's own claim, inside the card that argues it —
                    the screen's headline belongs to the promise being kept. */}
                <p class="proj__headline" data-projection-headline />
                {/* Two bars, not a spreadsheet. A reader who makes things for a
                    living does not want a row carried to one decimal place. */}
                <div class="gain" data-now-label={copy.plan.sides.now} data-then-label={copy.plan.sides.then}>
                  <div class="gain__col" data-bar="now">
                    <p class="gain__label" data-bar-label />
                    <div class="gain__track"><div class="gain__fill" data-bar-fill /></div>
                    <p class="gain__amount" data-bar-amount />
                    <p class="gain__pace" data-bar-pace />
                  </div>
                  <div class="gain__col gain__col--then" data-bar="then">
                    <p class="gain__label" data-bar-label />
                    <div class="gain__track"><div class="gain__fill" data-bar-fill /></div>
                    <p class="gain__amount" data-bar-amount />
                    <p class="gain__pace" data-bar-pace />
                  </div>
                </div>

                {/* The three windows. A month is the honest unit and a weak
                    argument — it is small enough to shrug at, and it hides that
                    the gap is paid again every month either way. */}
                <section
                  class="span"
                  data-horizons
                  data-horizons-new={copy.plan.horizonsNew}
                  data-when-month={copy.plan.horizonsWhen.month}
                  data-when-half={copy.plan.horizonsWhen.sixMonths}
                  data-when-year={copy.plan.horizonsWhen.year}
                  hidden
                >
                  <p class="span__title">{copy.plan.horizonsTitle}</p>
                  <ol class="span__list" data-horizons-list />
                </section>

                <ul class="moves" data-projection-moves />

                {/* Never fine print, but never the loudest thing on the screen
                    either: a projection ships with its assumption, folded away
                    for whoever wants to check the working. */}
                <details class="proj__working">
                  <summary>{copy.plan.working}</summary>
                  <p data-projection-assumption />
                </details>
              </div>

              {/* What a page this size could be doing, in its own numbers.
                  Arrives with the unlock, so it is drawn only when it exists. */}
              <section class="size" data-size hidden>
                <p class="size__title" data-size-title />
                <div class="size__list" data-size-list />
              </section>

              <div class="offer">
                <p class="offer__text" data-plan-body>{copy.plan.body}</p>
                <p class="offer__text" data-plan-body-starter hidden>{copy.plan.starterBody}</p>
              </div>

              <!-- The walk ends here, so it has to say where the door is. -->
              <p class="ways">
                <button class="ways__link" type="button" data-restart>{copy.plan.ways.again}</button>
                <span class="ways__sep" aria-hidden="true">·</span>
                <a class="ways__link" href="/">{copy.plan.ways.home}</a>
              </p>
            </div>
          )}

          {screen.kind === 'error' && (
            <div class="screen__inner">
              <p class="screen__eyebrow screen__eyebrow--alarm">{copy.runtime.errorEyebrow}</p>
              <h1 class="screen__title" data-error-message />

              <form class="lead" data-waiting-form novalidate hidden>
                <p class="lead__title">{copy.runtime.waitingTitle}</p>
                <label class="sr" for="waiting-email">{copy.result.emailLabel}</label>
                <input
                  class="start__input start__input--boxed"
                  id="waiting-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  placeholder={copy.result.placeholder}
                  required
                />
                <label class="lead__consent">
                  <input type="checkbox" data-waiting-consent />
                  <span>{copy.result.consent}</span>
                </label>
                <p class="field__error" data-waiting-error hidden />
                <button class="btn btn--wide" type="submit" data-waiting-submit>
                  {copy.runtime.waitingCta}
                </button>
              </form>

              <button class="btn btn--quiet btn--wide" type="button" data-retry>
                {copy.ui.retry}
              </button>

              <p class="ways">
                <a class="ways__link" href="/">{copy.plan.ways.home}</a>
              </p>
            </div>
          )}
        </section>
      ))
    }
  </main>

  <!-- ===================================================== CLONED AT RUNTIME -->
  <template data-tpl="fact">
    <article class="fact">
      <p class="fact__label"><span data-f="label"></span><span class="fact__held" data-f="held" hidden></span></p>
      {/* dir="auto" on both, because a figure and its sentence are the two places a read mixes
          scripts. On a Persian page an English value like "21 days" is a left-to-right run inside
          a right-to-left paragraph, and the paragraph's direction reorders it into "days 21" —
          true characters, wrong sentence. Letting each element take its direction from its own
          first strong character puts every wording the narrator can produce the right way round,
          in all three languages, without hardcoding a direction anywhere. */}
      <p class="fact__value" data-f="value" dir="auto"></p>
      <p class="fact__text" data-f="text" dir="auto"></p>
      {/* A shape to blur while the figure is held back. Never real text: a
          blur can be lifted, and a placeholder has nothing under it to lift. */}
      <div class="ghost" data-f="ghost" hidden aria-hidden="true">
        <i class="ghost__value"></i>
        <i class="ghost__line"></i>
        <i class="ghost__line ghost__line--short"></i>
      </div>
      <div class="meter" data-f="meter" hidden>
        <div class="meter__track"><i class="meter__fill" data-f="meter-fill"></i></div>
        <i class="meter__mark" data-f="meter-mark"></i>
        <p class="meter__legend" data-f="meter-legend"></p>
      </div>
    </article>
  </template>

  <template data-tpl="section">
    <section class="block">
      <header class="block__head">
        <h2 class="block__title" data-f="title"></h2>
        <p class="block__verdict" data-f="verdict"></p>
      </header>
      <div class="facts" data-f="facts"></div>
      <div class="field__list" data-f="peers" hidden></div>
    </section>
  </template>

  <template data-tpl="topic">
    <article class="topic">
      <span class="topic__format" data-f="format"></span>
      <p class="topic__title"><span data-f="title"></span><span class="fact__held" data-f="held" hidden></span></p>
      <p class="topic__hook" data-f="hook"></p>
      <div class="ghost" data-f="ghost" hidden aria-hidden="true">
        <i class="ghost__line"></i>
        <i class="ghost__line ghost__line--short"></i>
      </div>
    </article>
  </template>

  <template data-tpl="page">
    <article class="page">
      <p class="page__handle" data-f="handle" dir="ltr"></p>
      <dl class="page__stats">
        <div><dt data-f="followers-label"></dt><dd data-f="followers"></dd></div>
        <div><dt data-f="pace-label"></dt><dd data-f="pace"></dd></div>
        <div><dt data-f="rate-label"></dt><dd data-f="rate"></dd></div>
        <div><dt data-f="format-label"></dt><dd data-f="format"></dd></div>
      </dl>
    </article>
  </template>

  <template data-tpl="size-line">
    <article class="size__line">
      <p class="size__value" data-f="value"></p>
      <p class="size__text" data-f="text"></p>
    </article>
  </template>

  <template data-tpl="horizon">
      <li class="span__cell">
        <p class="span__when" data-f="label"></p>
        <p class="span__total" data-f="total"></p>
        <p class="span__new" data-f="extra"></p>
        <div class="span__track"><div class="span__fill" data-f="fill"></div></div>
      </li>
    </template>

    <template data-tpl="move">
    <li class="moves__item"><span data-f="text"></span></li>
  </template>

  <template data-tpl="rest">
    <article class="rest__card">
      <p class="rest__label" data-f="label"></p>
      <p class="rest__title" data-f="title"></p>
      <p class="rest__text" data-f="text"></p>
    </article>
  </template>
</div>

<style>
  /* Forward comes from the end edge and back from the start edge, whichever
     those are. Without this the whole walk animates backwards in Persian:
     "going back should not look like going forward" cuts both ways. */
  .funnel {
    --slide-in: 16px;
    --slide-back: -16px;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  /* Said plainly and kept on screen. Someone walking this before the backend
     exists should never reach the end and think the failure was theirs. */
  .preview {
    flex: none;
    padding: var(--s-2) var(--s-5);
    text-align: center;
    font-size: 12px;
    line-height: 1.45;
    color: var(--horn-soft);
    background: var(--paper-3);
    border-bottom: 1px solid var(--horn-deep);
  }

  /* ---- The bar ------------------------------------------------------------ */

  :global([dir='rtl']) .funnel {
    --slide-in: -16px;
    --slide-back: 16px;
  }

  :global([dir='rtl']) .bar__track i,
  :global([dir='rtl']) .meter__fill {
    background: linear-gradient(to left, var(--accent) 0%, var(--accent-soft) 100%);
  }

  /*
   * Persian small-caps labels, switched off rather than adjusted.
   *
   * Arabic script has no case, so `uppercase` can only ever fire on a stray
   * Latin word inside a Persian line — which then shouts. And positive tracking
   * breaks cursive joining outright: the letters stop connecting.
   *
   * This lives here rather than in base.css because Astro scopes component
   * styles with a generated attribute, which outranks any plain selector from a
   * global stylesheet. The rule has to be written where the rule it overrides is.
   */
  :global([lang='fa']) .screen__eyebrow,
  :global([lang='fa']) .rest__label,
  :global([lang='fa']) .fact__label,
  :global([lang='fa']) .topic__format,
  :global([lang='fa']) .field__title,
  :global([lang='fa']) .size__title,
  :global([lang='fa']) .page__stats dt,
  :global([lang='fa']) .gain__label {
    text-transform: none;
    letter-spacing: 0;
  }

  /* Five things across a phone is four too many, so the bar is a two-row grid
     that collapses to one the moment there is room. The progress track spans
     the full width on its own row rather than being squeezed between controls —
     a 40px-wide bar tells nobody anything. */
  .bar {
    flex: none;
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    grid-template-areas:
      'back count home lang'
      'track track track track';
    align-items: center;
    gap: var(--s-2) var(--s-3);
    padding: var(--s-3) var(--s-4);
    padding-top: max(var(--s-3), env(safe-area-inset-top));
    border-bottom: 1px solid var(--rule-soft);
    background: var(--paper);
  }

  @media (min-width: 40rem) {
    .bar {
      grid-template-columns: auto 1fr auto auto auto;
      grid-template-areas: 'back track count home lang';
      gap: var(--s-4);
      padding: var(--s-4) var(--s-5);
      padding-top: max(var(--s-4), env(safe-area-inset-top));
    }
  }

  .bar__back {
    grid-area: back;
    display: flex;
    align-items: center;
    gap: var(--s-1);
    min-height: 2.5rem;
    padding-inline: var(--s-2);
    border-radius: var(--r-3);
    color: var(--ink-2);
    font-size: 13px;
    transition:
      transform var(--dur-fast) var(--ease-out),
      color var(--dur) ease,
      opacity var(--dur) ease;
  }

  .bar__back svg {
    width: 20px;
    height: 20px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Mirrored rather than re-drawn: back is towards the start edge in both
     directions, and the start edge is on the right in Persian. */
  :global([dir='rtl']) .bar__back svg,
  :global([dir='rtl']) .bar__home svg {
    transform: scaleX(-1);
  }

  :global([dir='rtl']) .bar__home svg {
    transform: none;
  }

  .bar__back:active {
    transform: scale(0.98);
  }

  /* The way out. Quiet — it is an exit, not an action — but never absent, and
     never behind a menu: on a phone it keeps the house and drops the words. */
  .bar__home {
    grid-area: home;
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 2.5rem;
    padding-inline: var(--s-2);
    border-radius: var(--r-3);
    color: var(--ink-3);
    font-size: 13px;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur) ease;
  }

  .bar__home svg {
    width: 17px;
    height: 17px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  @media (hover: hover) and (pointer: fine) {
    .bar__home:hover {
      color: var(--ink-2);
    }
  }

  /* The words go first when the bar runs out of room; the icon and the count
     both keep meaning something on their own. */
  @media (max-width: 30rem) {
    .bar__back-word,
    .bar__home-word {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* Kept in the layout rather than removed, so the bar never reflows when the
     first step or the result takes the arrow away. */
  .bar__back[data-off] {
    opacity: 0;
    pointer-events: none;
  }

  .bar__track {
    grid-area: track;
    height: 3px;
    background: var(--rule-soft);
    border-radius: 3px;
    overflow: hidden;
  }

  .bar__track i {
    display: block;
    height: 100%;
    width: 0%;
    background: linear-gradient(to right, var(--accent) 0%, var(--accent-soft) 100%);
    /* Width, not transform: a 3px rule has no layout to thrash, and a scaled
       bar smears its own gradient. */
    transition: width var(--dur-slow) var(--ease-in-out);
  }


  .bar__count {
    grid-area: count;
    font-size: 12px;
    color: var(--ink-3);
    text-align: end;
    font-variant-numeric: tabular-nums;
  }

  .bar__count b {
    font-weight: 500;
    color: var(--ink-2);
  }

  .bar__count[data-off] {
    opacity: 0;
  }

  .bar__lang {
    grid-area: lang;
    display: flex;
    justify-content: flex-end;
    min-width: 0;
  }

  /* ---- The stage ---------------------------------------------------------- */

  /* One grid cell holds every screen, so a screen entering does not have to be
     positioned absolutely and the stage keeps its own scroll. */
  .stage {
    flex: 1;
    min-height: 0;
    display: grid;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* Anchored to the top, not centred. Screens carry different numbers of
     options, and centring moves the question up and down between them — the
     one element that should not move in a stepper is the question. */
  .screen {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: clamp(var(--s-5), 5vh, var(--s-8)) var(--s-5) var(--s-6);
    padding-bottom: max(var(--s-6), env(safe-area-inset-bottom));
  }

  /* The two screens that are a moment rather than a step do sit centred: there
     is no list under them whose length could shift anything. */
  /* ---- Proof ------------------------------------------------------------ */

  .proof__steps {
    margin: var(--s-6) 0 0;
    padding-inline-start: 1.4em;
    display: grid;
    gap: var(--s-3);
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .proof__steps b {
    font-weight: 600;
  }

  .proof__code {
    margin-top: var(--s-6);
    display: flex;
    align-items: center;
    gap: var(--s-4);
    flex-wrap: wrap;
  }

  .proof__digits {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: clamp(2rem, 1.2rem + 3vw, 2.75rem);
    letter-spacing: 0.18em;
    font-weight: 600;
    padding: var(--s-2) var(--s-4);
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: var(--paper-2);
    direction: ltr;
    user-select: all;
  }

  .proof__status {
    margin-top: var(--s-5);
    font-size: 0.9375rem;
    color: var(--ink-3);
  }

  .proof__status--ok {
    color: var(--ok, #1a7f4b);
    font-weight: 600;
  }

  .proof__status--warn {
    color: var(--warn, #a15c00);
  }

  .proof__ways {
    margin-top: var(--s-4);
    display: flex;
    gap: var(--s-5);
    font-size: 0.875rem;
  }

  .linklike {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: var(--ink-2);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .screen[data-kind='analyzing'],
  .screen[data-kind='error'] {
    justify-content: center;
  }

  .screen[data-live] {
    animation: screen-in var(--dur-slow) var(--ease-out) both;
  }

  /* Going back should not look like going forward. */
  .screen[data-live][data-reverse] {
    animation-name: screen-back;
  }

  @keyframes screen-in {
    from {
      opacity: 0;
      transform: translateX(var(--slide-in, 16px)) scale(0.98);
    }
  }

  @keyframes screen-back {
    from {
      opacity: 0;
      transform: translateX(var(--slide-back, -16px)) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .screen[data-live],
    .screen[data-live][data-reverse] {
