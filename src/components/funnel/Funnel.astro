---
/**
 * The read, as a funnel.
 *
 * One screen at a time, full viewport, tap an answer and it advances. Two
 * questions decide the rest of the walk: the first splits the audience, the
 * second asks what is in the way — and only the things someone actually admits
 * to become screens. So the walk is seven to ten screens long depending on the
 * answers, and every screen is rendered here at build time while
 * `src/scripts/funnel.ts` decides which of them are in the active set.
 *
 * No English lives in this file. Every string comes from a `FunnelCopy`, which
 * is what lets the same component serve `/read` and `/fa/read` — and what makes
 * a missing Persian string a compile error rather than an English word on a
 * Persian screen.
 */
import Screenshot from '../Screenshot.astro';
import { ICONS } from './icons';
import { EN } from './copy.en';
import type { FunnelCopy } from './types';

interface Props {
  /** False until the backend serves `/api/public/*`. Only changes what is said. */
  connected?: boolean;
  copy?: FunnelCopy;
}

const { connected = false, copy = EN } = Astro.props;
const screens = copy.screens;

/**
 * The step total is decided at runtime, not here.
 *
 * It used to be `screens.length` baked into the markup, which was true only
 * while every visitor walked every screen. Now the denominator depends on how
 * many blockers someone picks, so the bar is filled in by the script and this
 * is only a starting value that is replaced before anyone sees it.
 */
const alwaysShown = screens.filter((s) => s.kind !== 'error' && !s.showIf).length;
---

<div
  class="funnel"
  data-funnel
  data-locale={copy.locale}
  data-connected={connected ? 'yes' : 'no'}
>
  {/* Everything the script says at runtime, shipped as data rather than
      imported — so one script serves both languages and each page carries only
      its own strings. */}
  <script
    type="application/json"
    data-copy
    set:html={JSON.stringify({ ui: copy.ui, runtime: copy.runtime, result: copy.result })}
  />
  {!connected && <p class="preview">{copy.preview}</p>}

  <!-- ================================================================== BAR -->
  <header class="bar">
    <button class="bar__back" type="button" data-back aria-label={copy.bar.back}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 19l-7-7 7-7" /></svg>
    </button>
    <div class="bar__track" role="presentation"><i data-progress></i></div>
    <p class="bar__count"><b data-step-now>1</b> / <b data-step-total>{alwaysShown}</b></p>
  </header>

  <!-- ============================================================== SCREENS -->
  <main class="stage">
    {
      screens.map((screen) => (
        <section
          class="screen"
          data-screen={screen.id}
          data-kind={screen.kind}
          data-when={screen.showIf ? `${screen.showIf.screen}:${screen.showIf.is}` : undefined}
          hidden
        >
          {screen.kind === 'question' && (
            <div class:list={['screen__inner', screen.shot && 'screen__inner--wide']}>
              <p class="screen__eyebrow">{screen.eyebrow}</p>
              {/* A second wording of the same question, chosen at runtime from
                  the answer to the first one. */}
              <h1
                class="screen__title"
                data-title
                data-title-when={screen.titleWhen ? JSON.stringify(screen.titleWhen) : undefined}
              >
                {screen.title}
              </h1>
              {screen.hint && <p class="screen__hint">{screen.hint}</p>}

              {screen.shot && (
                <div class="screen__mascot">
                  <img src={screen.shot.src} alt={screen.shot.alt} width="360" height="360" loading="eager" />
                </div>
              )}

              <div class:list={['options', screen.options.length > 4 && 'options--tight']}>
                {screen.options.map((o) => (
                  <button
                    class="option"
                    type="button"
                    data-option={o.value}
                    aria-pressed={screen.multi ? 'false' : undefined}
                  >
                    <span class="option__icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" set:html={ICONS[o.icon]} />
                    </span>
                    <span class="option__text">
                      <span class="option__label">{o.label}</span>
                      {o.sub && <span class="option__sub">{o.sub}</span>}
                    </span>
                    <span class="option__tick" aria-hidden="true">
                      <svg viewBox="0 0 24 24"><path d="m5 13 4 4L19 7" /></svg>
                    </span>
                  </button>
                ))}
              </div>
              {screen.multi && (
                <button class="btn btn--wide" type="button" data-continue disabled>
                  {copy.ui.continue}
                </button>
              )}
            </div>
          )}

          {screen.kind === 'insight' && (
            <div class="screen__inner screen__inner--wide">
              <p class="screen__eyebrow">{screen.eyebrow}</p>
              {/* Their own words first. The joke only lands because the sentence
                  above it is the one they just picked. */}
              {screen.quote && <p class="screen__quote">“{screen.quote}”</p>}
              <p class="screen__hook">{screen.hook}</p>
              <h1 class="screen__title">{screen.title}</h1>
              <p class="screen__lead">{screen.lead}</p>
              <div class="screen__shot">
                <Screenshot
                  src={screen.shot.src}
                  alt={screen.shot.alt}
                  width={1280}
                  height={800}
                  label={screen.shot.label}
                />
              </div>
              <button class="btn btn--wide" type="button" data-next>
                {copy.ui.next}
              </button>
            </div>
          )}

          {screen.kind === 'start' && (
            <div class="screen__inner screen__inner--wide">
              <p class="screen__eyebrow">{screen.eyebrow}</p>
              <p class="screen__hook">{screen.hook}</p>
              <h1 class="screen__title">{screen.title}</h1>
              <p class="screen__lead">{screen.lead}</p>
              <div class="screen__shot">
                <Screenshot
                  src={screen.shot.src}
                  alt={screen.shot.alt}
                  width={1280}
                  height={800}
                  label={screen.shot.label}
                />
              </div>

              <form class="start" data-start-form data-field={screen.field} novalidate>
                {screen.field === 'handle' ? (
                  <div class="start__field">
                    <span class="start__at" aria-hidden="true">@</span>
                    <label class="sr" for={`in-${screen.id}`}>{screen.title}</label>
                    <input
                      class="start__input"
                      id={`in-${screen.id}`}
                      data-handle
                      type="text"
                      autocomplete="off"
                      autocapitalize="off"
                      autocorrect="off"
                      spellcheck="false"
                      maxlength="30"
                      placeholder={screen.placeholder}
                    />
                  </div>
                ) : (
                  <div>
                    <label class="sr" for={`in-${screen.id}`}>{screen.title}</label>
                    <textarea
                      class="start__area"
                      id={`in-${screen.id}`}
                      data-idea
                      rows="3"
                      maxlength="400"
                      placeholder={screen.placeholder}
                    />
                  </div>
                )}
                <p class="field__error" data-start-error hidden />
                <button class="btn btn--wide" type="submit">{screen.cta}</button>
              </form>
            </div>
          )}

          {screen.kind === 'analyzing' && (
            <div class="screen__inner screen__inner--wide">
              <div class="ring" role="presentation">
                <svg viewBox="0 0 120 120">
                  <circle class="ring__track" cx="60" cy="60" r="52" />
                  <circle class="ring__fill" cx="60" cy="60" r="52" data-ring />
                </svg>
                <p class="ring__pct"><b data-pct>0</b>%</p>
              </div>
              <h1 class="screen__title screen__title--mid" data-analyzing-line>
                {copy.analyzing.line}
              </h1>
              <p class="screen__tip">{copy.analyzing.lead}</p>

              {/* Whatever they did not pick, plus the two nobody is asked about.
                  The wait is the only place left to say these, and it is long
                  enough now that the handle is asked at the end. */}
              <div class="rest" data-rest />

              <div class="screen__shot screen__shot--quiet">
                <Screenshot
                  src={copy.analyzing.shot.src}
                  alt={copy.analyzing.shot.alt}
                  width={1280}
                  height={800}
                  label={copy.analyzing.shot.label}
                />
              </div>
              <script type="application/json" data-features set:html={JSON.stringify(copy.features)} />
            </div>
          )}

          {screen.kind === 'result' && (
            <div class="screen__inner screen__inner--wide">
              <p class="screen__eyebrow">{copy.result.eyebrow}</p>
              <h1 class="screen__title" data-result-headline />
              <div class="facts" data-facts />
              <div class="topics" data-topics hidden />

              <form class="lead" data-lead-form novalidate>
                <p class="lead__title">{copy.result.teaser}</p>
                <label class="sr" for="email">{copy.result.emailLabel}</label>
                <input
                  class="start__input start__input--boxed"
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  inputmode="email"
                  placeholder={copy.result.placeholder}
                  required
                />
                <label class="lead__consent">
                  <input type="checkbox" data-consent />
                  <span>{copy.result.consent}</span>
                </label>
                <p class="field__error" data-lead-error hidden />
                <button class="btn btn--wide" type="submit" data-lead-submit>
                  {copy.result.cta}
                </button>
              </form>
            </div>
          )}

          {screen.kind === 'plan' && (
            <div class="screen__inner screen__inner--wide">
              <p class="screen__eyebrow">{copy.plan.eyebrow}</p>
              <h1
                class="screen__title"
                data-plan-headline
                data-plan-headline-starter={copy.plan.starterHeadline}
              >
                {copy.plan.headline}
              </h1>

              <p class="screen__lead" data-projection-none hidden>{copy.runtime.noProjection}</p>

              <div class="proj" data-projection hidden>
                {/* The projection's own claim, inside the card that argues it —
                    the screen's headline belongs to the promise being kept. */}
                <p class="proj__headline" data-projection-headline />
                {/* Two bars, not a spreadsheet. A reader who makes things for a
                    living does not want a row carried to one decimal place. */}
                <div class="gain">
                  <div class="gain__col" data-bar="now">
                    <p class="gain__label" data-bar-label />
                    <div class="gain__track"><div class="gain__fill" data-bar-fill /></div>
                    <p class="gain__amount" data-bar-amount />
                    <p class="gain__pace" data-bar-pace />
                  </div>
                  <div class="gain__col gain__col--then" data-bar="then">
                    <p class="gain__label" data-bar-label />
                    <div class="gain__track"><div class="gain__fill" data-bar-fill /></div>
                    <p class="gain__amount" data-bar-amount />
                    <p class="gain__pace" data-bar-pace />
                  </div>
                </div>

                <ul class="moves" data-projection-moves />

                {/* Never fine print, but never the loudest thing on the screen
                    either: a projection ships with its assumption, folded away
                    for whoever wants to check the working. */}
                <details class="proj__working">
                  <summary>{copy.plan.working}</summary>
                  <p data-projection-assumption />
                </details>
              </div>

              <div class="offer">
                <p class="offer__text" data-plan-body>{copy.plan.body}</p>
                <p class="offer__text" data-plan-body-starter hidden>{copy.plan.starterBody}</p>
              </div>

              <!-- The walk ends here, so it has to say where the door is. -->
              <p class="ways">
                <button class="ways__link" type="button" data-restart>{copy.plan.ways.again}</button>
                <span class="ways__sep" aria-hidden="true">·</span>
                <a class="ways__link" href="/">{copy.plan.ways.home}</a>
              </p>
            </div>
          )}

          {screen.kind === 'error' && (
            <div class="screen__inner">
              <p class="screen__eyebrow screen__eyebrow--alarm">{copy.runtime.errorEyebrow}</p>
              <h1 class="screen__title" data-error-message />

              <form class="lead" data-waiting-form novalidate hidden>
                <p class="lead__title">{copy.runtime.waitingTitle}</p>
                <label class="sr" for="waiting-email">{copy.result.emailLabel}</label>
                <input
                  class="start__input start__input--boxed"
                  id="waiting-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  placeholder={copy.result.placeholder}
                  required
                />
                <label class="lead__consent">
                  <input type="checkbox" data-waiting-consent />
                  <span>{copy.result.consent}</span>
                </label>
                <p class="field__error" data-waiting-error hidden />
                <button class="btn btn--wide" type="submit" data-waiting-submit>
                  {copy.runtime.waitingCta}
                </button>
              </form>

              <button class="btn btn--quiet btn--wide" type="button" data-retry>
                {copy.ui.retry}
              </button>

              <p class="ways">
                <a class="ways__link" href="/">{copy.plan.ways.home}</a>
              </p>
            </div>
          )}
        </section>
      ))
    }
  </main>

  <!-- ===================================================== CLONED AT RUNTIME -->
  <template data-tpl="fact">
    <article class="fact">
      <p class="fact__label" data-f="label"></p>
      <p class="fact__value" data-f="value"></p>
      <p class="fact__text" data-f="text"></p>
      <div class="meter" data-f="meter" hidden>
        <div class="meter__track"><i class="meter__fill" data-f="meter-fill"></i></div>
        <i class="meter__mark" data-f="meter-mark"></i>
        <p class="meter__legend" data-f="meter-legend"></p>
      </div>
    </article>
  </template>

  <template data-tpl="topic">
    <article class="topic">
      <span class="topic__format" data-f="format"></span>
      <p class="topic__title" data-f="title"></p>
      <p class="topic__hook" data-f="hook"></p>
    </article>
  </template>

  <template data-tpl="move">
    <li class="moves__item"><span data-f="text"></span></li>
  </template>

  <template data-tpl="rest">
    <article class="rest__card">
      <p class="rest__label" data-f="label"></p>
      <p class="rest__title" data-f="title"></p>
      <p class="rest__text" data-f="text"></p>
    </article>
  </template>
</div>

<style>
  .funnel {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  /* Said plainly and kept on screen. Someone walking this before the backend
     exists should never reach the end and think the failure was theirs. */
  .preview {
    flex: none;
    padding: var(--s-2) var(--s-5);
    text-align: center;
    font-size: 12px;
    line-height: 1.45;
    color: var(--horn-soft);
    background: var(--paper-3);
    border-bottom: 1px solid var(--horn-deep);
  }

  /* ---- The bar ------------------------------------------------------------ */

  .bar {
    flex: none;
    display: grid;
    grid-template-columns: 2.5rem 1fr 3.5rem;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-4) var(--s-5);
    padding-top: max(var(--s-4), env(safe-area-inset-top));
    border-bottom: 1px solid var(--rule-soft);
    background: var(--paper);
  }

  .bar__back {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--r-3);
    color: var(--ink-2);
    transition:
      transform var(--dur-fast) var(--ease-out),
      color var(--dur) ease,
      opacity var(--dur) ease;
  }

  .bar__back svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .bar__back:active {
    transform: scale(0.98);
  }

  /* Kept in the layout rather than removed, so the bar never reflows when the
     first step or the result takes the arrow away. */
  .bar__back[data-off] {
    opacity: 0;
    pointer-events: none;
  }

  .bar__track {
    height: 3px;
    background: var(--rule-soft);
    border-radius: 3px;
    overflow: hidden;
  }

  .bar__track i {
    display: block;
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--accent) 0%, var(--accent-soft) 100%);
    /* Width, not transform: a 3px rule has no layout to thrash, and a scaled
       bar smears its own gradient. */
    transition: width var(--dur-slow) var(--ease-in-out);
  }

  .bar__count {
    font-size: 12px;
    color: var(--ink-3);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .bar__count b {
    font-weight: 500;
    color: var(--ink-2);
  }

  .bar__count[data-off] {
    opacity: 0;
  }

  /* ---- The stage ---------------------------------------------------------- */

  /* One grid cell holds every screen, so a screen entering does not have to be
     positioned absolutely and the stage keeps its own scroll. */
  .stage {
    flex: 1;
    min-height: 0;
    display: grid;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* Anchored to the top, not centred. Screens carry different numbers of
     options, and centring moves the question up and down between them — the
     one element that should not move in a stepper is the question. */
  .screen {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: clamp(var(--s-5), 5vh, var(--s-8)) var(--s-5) var(--s-6);
    padding-bottom: max(var(--s-6), env(safe-area-inset-bottom));
  }

  /* The two screens that are a moment rather than a step do sit centred: there
     is no list under them whose length could shift anything. */
  .screen[data-kind='analyzing'],
  .screen[data-kind='error'] {
    justify-content: center;
  }

  .screen[data-live] {
    animation: screen-in var(--dur-slow) var(--ease-out) both;
  }

  /* Going back should not look like going forward. */
  .screen[data-live][data-reverse] {
    animation-name: screen-back;
  }

  @keyframes screen-in {
    from {
      opacity: 0;
      transform: translateX(16px) scale(0.98);
    }
  }

  @keyframes screen-back {
    from {
      opacity: 0;
      transform: translateX(-16px) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .screen[data-live],
    .screen[data-live][data-reverse] {
      animation-name: screen-fade;
    }

    @keyframes screen-fade {
      from {
        opacity: 0;
      }
    }
  }

  .screen__inner {
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  .screen__inner--wide {
    max-width: 44rem;
  }

  .screen__eyebrow {
    font-size: var(--t-eyebrow);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--horn);
    line-height: 1;
  }

  .screen__eyebrow--alarm {
    color: var(--alarm);
  }

  .screen__title {
    font-size: var(--t-subhead);
    line-height: 1.14;
    max-width: 22ch;
  }

  .screen__title--mid {
    text-align: center;
    max-width: 24ch;
    margin-inline: auto;
  }

  .screen__lead {
    font-size: var(--t-meta);
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 54ch;
  }

  .screen__hint {
    font-size: 12px;
    color: var(--ink-3);
    margin-top: calc(var(--s-2) * -1);
  }

  /* Their own words, before the joke that answers them. Quiet and set back, so
     it reads as something being repeated rather than something being said. */
  .screen__quote {
    margin-block: var(--s-3) var(--s-2);
    padding-inline-start: var(--s-4);
    border-inline-start: 2px solid var(--rule);
    font-size: var(--t-meta);
    line-height: 1.5;
    color: var(--ink-3);
    max-width: 54ch;
  }

  /* The joke. It goes above the headline because it is the reason anyone reads
     the headline. */
  .screen__hook {
    margin-block: var(--s-3);
    font-size: var(--t-meta);
    line-height: 1.6;
    color: var(--horn);
    max-width: 54ch;
  }

  .screen__mascot {
    margin-block: var(--s-4);
    display: flex;
    justify-content: center;
  }

  .screen__mascot img {
    width: min(220px, 42vw);
    height: auto;
  }

  /* The cards shown while the read runs — everything he also does. */
  .rest {
    margin-top: var(--s-5);
    display: grid;
    /* Two across on anything wide enough. The card count varies from two to six
       depending on what was picked, and two columns is the only width that
       never leaves a single card stranded on a row of its own. */
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: var(--s-4);
    text-align: start;
  }

  .rest__card {
    padding: var(--s-4);
    background: var(--paper-2);
    background-image: var(--sheen);
    border: 1px solid var(--rule);
    border-radius: var(--r-3);
  }

  .rest__label {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--horn);
  }

  .rest__title {
    margin-top: var(--s-2);
    font-family: var(--font-display);
    font-size: 17px;
    line-height: 1.25;
    color: var(--ink);
  }

  .rest__text {
    margin-top: var(--s-2);
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-3);
  }

  /* The capture under the wait is scenery, not the subject. */
  .screen__shot--quiet {
    opacity: 0.55;
  }

  .screen__shot {
    margin-block: var(--s-2);
  }

  /* ---- Options ------------------------------------------------------------ */

  .options {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  .options--tight {
    gap: var(--s-2);
  }

  .option {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-4) var(--s-4);
    text-align: left;
    background: var(--paper-2);
    background-image: var(--sheen);
    border: 1px solid var(--rule);
    border-radius: var(--r-3);
    transition:
      transform var(--dur-fast) var(--ease-out),
      border-color var(--dur) ease,
      background-color var(--dur) ease;
  }

  .option:active {
    transform: scale(0.98);
  }

  /* Champagne marks the choice — a border where a mark is meant to be noticed,
     which is the one place DNA §4 allows a coloured hairline. */
  .option[data-chosen] {
    border-color: var(--horn);
    background-color: var(--paper-4);
  }

  .option__icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--r-2);
    background: var(--paper-3);
    border: 1px solid var(--rule-soft);
    color: var(--accent-soft);
  }

  .option[data-chosen] .option__icon {
    color: var(--horn);
    border-color: var(--horn-deep);
  }

  .option__icon svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .option__text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .option__label {
    font-size: var(--t-body);
    line-height: 1.3;
  }

  .option__sub {
    font-size: 12px;
    color: var(--ink-3);
    line-height: 1.4;
  }

