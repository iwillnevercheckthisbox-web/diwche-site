---
/**
 * The language switch.
 *
 * A `<details>` rather than a row of links: three names side by side is a lot
 * of chrome for something most readers use once, and in a right-to-left page a
 * Latin name sitting next to a Persian one reorders badly. Closed, it is one
 * word; open, it is a short list.
 *
 * No JavaScript. `<details>` opens on its own, works before hydration, and is
 * keyboard-operable without anything being wired up.
 */
import { ENDONYM, LOCALES, pathIn, type Locale } from '../lib/direction';

interface Props {
  locale: Locale;
  /** The page to stay on while changing language. */
  path: string;
  /** The word on the closed control, in the current language. */
  label: string;
  compact?: boolean;
}

const { locale, path, label, compact = false } = Astro.props;
---

<details class:list={['lang', compact && 'lang--compact']}>
  <summary class="lang__summary" aria-label={label}>
    <span class="lang__label">{label}</span>
    <span class="lang__now" lang={locale}>{ENDONYM[locale]}</span>
    <svg class="lang__caret" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
  </summary>

  <ul class="lang__menu">
    {
      LOCALES.map((l) => (
        <li>
          <a
            class="lang__item"
            href={pathIn(l, path)}
            hreflang={l}
            lang={l}
            aria-current={l === locale ? 'true' : undefined}
          >
            {ENDONYM[l]}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .lang {
    position: relative;
    font-size: 12px;
  }

  .lang__summary {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: 6px 10px;
    color: var(--ink-3);
    cursor: pointer;
    border: 1px solid var(--rule);
    border-radius: var(--r-2);
    list-style: none;
    white-space: nowrap;
  }

  /* Safari draws its own triangle unless both of these are said. */
  .lang__summary::-webkit-details-marker {
    display: none;
  }

  .lang__summary:hover {
    color: var(--ink-2);
    border-color: var(--horn);
  }

  .lang__label {
    color: var(--ink-3);
  }

  .lang__now {
    color: var(--ink-2);
    /* Its own script, so it is isolated from the label beside it. */
    unicode-bidi: isolate;
  }

  .lang__caret {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    transition: transform var(--dur) var(--ease-out);
  }

  .lang[open] .lang__caret {
    transform: rotate(180deg);
  }

  .lang__menu {
    position: absolute;
    top: calc(100% + 6px);
    /* Anchored to the reading edge, so it opens inwards in both directions. */
    inset-inline-end: 0;
    z-index: 60;
    min-width: 9rem;
    padding: 6px;
    list-style: none;
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--r-2);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.28);
  }

  .lang__item {
    display: block;
    padding: 7px 10px;
    border-radius: var(--r-1);
    color: var(--ink-2);
    text-decoration: none;
    unicode-bidi: isolate;
  }

  .lang__item:hover {
    background: var(--paper-4);
    color: var(--ink);
  }

  .lang__item[aria-current] {
    color: var(--horn);
  }

  .lang--compact .lang__summary {
    padding: 4px 8px;
    font-size: 11px;
  }

  @media (max-width: 720px) {
    .lang__label {
      display: none;
    }
  }
</style>
