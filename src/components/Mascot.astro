---
/**
 * Diwche, in one of his four scenes.
 *
 * The art is a self-contained animated SVG built by `npm run mascot:build` from
 * `mascot/new resources/`. Everything lives inside that file — the cut-out
 * drawing, the float and breathe keyframes, and its own reduced-motion rule — so
 * this component is an <img> and nothing more. No player to download, no script
 * to run, no layout shift: the intrinsic size comes from the build manifest.
 *
 * Two of the four (connecting, posting) were drawn on black and carry a dark
 * panel of their own; the other two are cut free. That is deliberate, not an
 * oversight — see scripts/build-mascot.py.
 */
import manifest from '../../public/mascot/v2/manifest.json';

type Scene = 'thinking' | 'connecting' | 'working-hard' | 'posting';

interface Props {
  scene: Scene;
  /** Overrides the description baked into the SVG. */
  alt?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { scene, alt, class: className = '', loading = 'lazy' } = Astro.props;

const art = manifest.find((m) => m.slug === scene);
if (!art) throw new Error(`unknown mascot scene "${scene}" — run npm run mascot:build`);
---

<img
  class:list={['mascot', className]}
  src={`/mascot/v2/${scene}.svg`}
  alt={alt ?? art.alt}
  width={art.width}
  height={art.height}
  loading={loading}
  decoding="async"
  fetchpriority={loading === 'eager' ? 'high' : undefined}
/>

<style>
  .mascot {
    width: 100%;
    height: auto;
  }
</style>
