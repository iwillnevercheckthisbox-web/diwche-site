---
/**
 * A real app capture, framed in CSS rather than baked into the PNG.
 *
 * Keeping the chrome in CSS means the frame stays crisp at any DPR, restyles
 * with the tokens, and callout labels stay editable — and translatable — HTML.
 *
 * Callouts are positioned with percentages so they survive a re-shoot at a
 * different size.
 */
interface Callout {
  /** Percentage from the left/top edge of the image. */
  x: number;
  y: number;
  text: string;
}

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  /** Shown in the frame's title bar. Omit for a bare frame. */
  label?: string;
  callouts?: Callout[];
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  label,
  callouts = [],
  loading = 'lazy',
  class: className = '',
} = Astro.props;

/* ①②③… — the marker glyphs, so the legend and the image use the same symbol. */
const MARKS = ['①', '②', '③', '④', '⑤', '⑥', '⑦', '⑧', '⑨'];
---

<figure class:list={['shot', className]}>
  <div class="shot__frame">
    <div class="shot__bar">
      <span class="shot__dots" aria-hidden="true"><i></i><i></i><i></i></span>
      {label && <span class="shot__label">{label}</span>}
    </div>
    <div class="shot__viewport">
      <img src={src} alt={alt} width={width} height={height} loading={loading} decoding="async" />
      {
        callouts.map((c, i) => (
          <span class="shot__mark" style={`--x:${c.x}%; --y:${c.y}%`} aria-hidden="true">
            {i + 1}
          </span>
        ))
      }
    </div>
  </div>
  {
    callouts.length > 0 && (
      <figcaption class="shot__legend">
        <ol>
          {callouts.map((c, i) => (
            <li>
              <span class="shot__mark shot__mark--inline" aria-hidden="true">{i + 1}</span>
              {c.text}
            </li>
          ))}
        </ol>
      </figcaption>
    )
  }
</figure>

<style>
  .shot {
    width: 100%;
  }

  .shot__frame {
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--r-3);
    box-shadow: var(--shadow-frame);
    overflow: hidden;
    /* Only transform/opacity — no layout properties. */
    transition:
      transform var(--dur-slow) var(--ease-out),
      box-shadow var(--dur-slow) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .shot__frame:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-frame-lift);
    }
  }

  .shot__bar {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    height: 28px;
    padding-inline: var(--s-3);
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }

  .shot__dots {
    display: flex;
    gap: 5px;
  }

  .shot__dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--rule);
  }

  .shot__label {
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--ink-3);
  }

  .shot__viewport {
    position: relative;
  }

  .shot__viewport img {
    width: 100%;
    height: auto;
  }

  /* ---- Callouts ----------------------------------------------------------
     Numbered markers on the image, and the words underneath it.

     Labels used to be drawn on the screenshot itself, next to their dot. That
     works on a marketing hero with two of them and fails on a documentation
     capture: the label covers the interface it is pointing at, a long one runs
     out of the frame, and there is no position that is clear of the content on
     both a wide crop and a tall one. A number never covers more than a number's
     worth, and the text below is real text — selectable, translatable, and
     readable at any width. */

  .shot__mark {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--horn);
    color: #0b0b0d;
    font-size: 12px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    /* Reads on both a dark screenshot and a light one. */
    box-shadow:
      0 0 0 2px var(--paper-2),
      0 0 0 4px rgba(201, 166, 104, 0.28);
  }

  .shot__mark--inline {
    position: static;
    transform: none;
    flex: none;
    box-shadow: none;
  }

  .shot__legend {
    margin-block-start: var(--s-3);
  }

  .shot__legend ol {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shot__legend li {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    font-size: var(--t-meta);
    line-height: 1.5;
    color: var(--ink-2);
  }

</style>
