---
/**
 * The top bar, in whichever language the page is in.
 *
 * Links point at sections of the homepage for that language, so a Persian
 * reader following "امکانات" lands on the Persian page rather than being
 * dropped back into English half-way through.
 */
import LangSwitch from './LangSwitch.astro';
import { DEFAULT_LOCALE, type Locale } from '../lib/direction';
import { HOME_EN, type HomeCopy } from '../content/home';

interface Props {
  copy?: HomeCopy;
  locale?: Locale;
}

const { copy = HOME_EN, locale = DEFAULT_LOCALE } = Astro.props;
const links = copy.nav.links;
const path = Astro.url.pathname;
---

<header class="nav">
  <div class="nav__inner">
    <a class="nav__brand" href={locale === 'en' ? '/' : `/${locale}/`}>
      <img class="nav__mark" src="/brand/horns.png" alt="" width="256" height="166" />
      Diwche
    </a>

    <nav class="nav__links" aria-label="Main">
      {
        links.map((l) => (
          <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>

    {/* The same links, for the width they were previously deleted at. Rendered
        rather than cloned, so a phone gets real anchors with no script between
        the reader and the page. */}
    <button
      class="nav__burger"
      type="button"
      aria-label={copy.nav.menu}
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path class="nav__burger-top" d="M4 7h16" />
        <path class="nav__burger-mid" d="M4 12h16" />
        <path class="nav__burger-bot" d="M4 17h16" />
      </svg>
    </button>

    <LangSwitch locale={locale} path={path} label={copy.nav.language} compact />

    <button class="nav__theme" type="button" aria-label={copy.nav.theme}>
      <svg class="nav__icon nav__icon--sun" viewBox="0 0 20 20" aria-hidden="true">
        <circle cx="10" cy="10" r="3.6" />
        <g stroke-linecap="round">
          <path d="M10 1.8v2M10 16.2v2M18.2 10h-2M3.8 10h-2" />
          <path d="M15.8 4.2l-1.4 1.4M5.6 14.4l-1.4 1.4M15.8 15.8l-1.4-1.4M5.6 5.6L4.2 4.2" />
        </g>
      </svg>
      <svg class="nav__icon nav__icon--moon" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M16.5 12.4A7 7 0 0 1 7.6 3.5a7 7 0 1 0 8.9 8.9z" />
      </svg>
    </button>

    <a class="btn nav__cta" href={locale === 'en' ? '/read' : `/${locale}/read`}>{copy.nav.cta}</a>
  </div>

  <nav class="nav__menu" id="nav-menu" aria-label={copy.nav.menu} hidden>
    {
      links.map((l) => (
        <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) ease;
  }

  /* Hairline only once the page has moved — no border against the hero. */
  .nav:not([data-top]) {
    border-bottom-color: var(--rule);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    width: 100%;
    max-width: var(--width);
    margin-inline: auto;
    padding: var(--s-3) var(--s-5);
  }

  /* The theme switch. A quiet icon button — it is a preference, not an action,
     so it never competes with the CTA beside it. */
  .nav__theme {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border-radius: var(--r-2);
    color: var(--ink-2);
    transition:
      color var(--dur) ease,
      background-color var(--dur) ease;
  }

  .nav__icon {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
  }

  .nav__icon--moon {
    fill: currentColor;
    stroke: none;
  }

  /* Show the room you would switch *to*, not the one you are in. */
  .nav__icon--sun {
    display: none;
  }

  :global([data-theme='dark']) .nav__icon--sun {
    display: block;
  }

  :global([data-theme='dark']) .nav__icon--moon {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav__theme:hover {
      color: var(--ink);
      background-color: var(--paper-4);
    }
  }

  /* The one pill on the site (DNA §4). `.btn` itself is 10px everywhere else. */
  .nav__cta {
    border-radius: var(--r-pill);
    /* A pill is a shape that only works on one line. Wrapped, it becomes a
       lozenge nearly as tall as it is wide — which is what "خوانش رایگان" did
       to it on a phone, where the label is twelve characters and the space
       beside the wordmark is not. */
    white-space: nowrap;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--font-display);
    font-variation-settings: var(--display-axes);
    font-size: 1.5rem;
    letter-spacing: -0.04em;
    text-decoration: none;
    margin-right: auto;
  }

  /* The horns are the mark — the anatomy is the brand (DNA §6), so the logo is
     the drawing rather than a letterform. Decorative: the wordmark beside it
     already says the name. */
  .nav__mark {
    width: 28px;
    height: auto;
  }

  .nav__links {
    display: flex;
    gap: var(--s-5);
  }

  .nav__links a {
    font-size: var(--t-meta);
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--dur) ease;
  }

  .nav__links a[aria-current='page'] {
    color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav__links a:hover {
      color: var(--ink);
    }
  }

  /* ---- The phone ---------------------------------------------------------- */

  /* Shown only where the row of links is not. It is a control that exists to
     replace something, so it appears exactly where that something goes. */
  .nav__burger {
    display: none;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border-radius: var(--r-2);
    color: var(--ink-2);
    transition: color var(--dur) ease;
  }

  .nav__burger svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }

  .nav__burger path {
    transition:
      transform var(--dur) var(--ease-out),
      opacity var(--dur-fast) ease;
    transform-origin: center;
  }

  .nav__burger[aria-expanded='true'] .nav__burger-top {
    transform: translateY(5px) rotate(45deg);
  }

  .nav__burger[aria-expanded='true'] .nav__burger-mid {
    opacity: 0;
  }

  .nav__burger[aria-expanded='true'] .nav__burger-bot {
    transform: translateY(-5px) rotate(-45deg);
  }

  /* A panel under the bar rather than a full-screen takeover: there are five
     links, and covering the page to show five links is a gesture, not a menu.
     Hidden with the `hidden` attribute so it is genuinely gone for a reader
     using a screen reader, not merely invisible. */
  .nav__menu {
    display: grid;
    padding: var(--s-2) var(--s-5) var(--s-4);
    border-top: 1px solid var(--rule-soft);
    background: var(--paper);
  }

  .nav__menu a {
    padding-block: var(--s-3);
    font-size: 1.0625rem;
    color: var(--ink-2);
    text-decoration: none;
    border-bottom: 1px solid var(--rule-soft);
  }

  .nav__menu a:last-child {
    border-bottom: 0;
  }

  .nav__menu a[aria-current='page'] {
    color: var(--ink);
  }

  @media (max-width: 760px) {
    .nav__links {
      display: none;
    }

    .nav__burger {
      display: grid;
    }

    /* The bar was five items wide with a --s-6 gap between each, which is what
       pushed it onto a second and then a third row and left --nav-h chasing it
       from tokens.css. Four items and a tighter gap fit on one line down to
       320px, brand included. */
    .nav__inner {
      gap: var(--s-3);
      padding-inline: var(--s-4);
    }

    .nav__brand {
      font-size: 1.25rem;
    }
  }

  /* Below this the pill and the wordmark cannot both be full size. The CTA is
     the reason the bar exists, so the wordmark gives way. */
  @media (max-width: 420px) {
    .nav__brand {
      font-size: 1.125rem;
    }

    .nav__cta {
      padding-inline: var(--s-4);
      font-size: var(--t-meta);
    }
  }

  /* The panel is a phone thing. Above 760px the links are in the bar and this
     must never appear, whatever state the button was left in. */
  @media (min-width: 761px) {
    .nav__menu {
      display: none;
    }
  }
</style>

<script>
  // Theme switch. The resolved theme is already on <html> — set before first
  // paint in Base.astro — so this only ever flips it and remembers the choice.
  const GROUND = { dark: '#05070c', light: '#f7f6f2' };
  const toggle = document.querySelector<HTMLButtonElement>('.nav__theme');

  if (toggle) {
    const root = document.documentElement;

    const label = () =>
      toggle.setAttribute(
        'aria-label',
        root.dataset.theme === 'dark' ? 'Switch to the light theme' : 'Switch to the dark theme'
      );

    label();

    toggle.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      label();

      try {
        localStorage.setItem('diwche-theme', next);
      } catch (e) {
        // Private mode. The choice just won't outlive the tab.
      }

      // The two media-gated <meta> tags can't follow an explicit choice, so once
      // there is one they are replaced by a single unconditional tag.
      for (const tag of document.querySelectorAll('meta[name="theme-color"]')) tag.remove();
      const meta = document.createElement('meta');
      meta.name = 'theme-color';
      meta.content = GROUND[next];
      document.head.appendChild(meta);
    });
  }

  // The phone menu. Nothing here creates the links — they are in the document
  // already — so this only decides whether they are shown, and says so on the
  // button for anyone who cannot see it.
  const burger = document.querySelector<HTMLButtonElement>('.nav__burger');
  const menu = document.querySelector<HTMLElement>('#nav-menu');

  if (burger && menu) {
    const show = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
    };

    burger.addEventListener('click', () => show(burger.getAttribute('aria-expanded') !== 'true'));

    // Following a link is the whole point of the menu, so it closes behind you —
    // including for an in-page anchor, where nothing navigates and the panel
    // would otherwise sit over the section it just scrolled to.
    for (const link of menu.querySelectorAll('a')) {
      link.addEventListener('click', () => show(false));
    }

    addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape' && !menu.hidden) {
        show(false);
        burger.focus();
      }
    });

    // Widening past the breakpoint puts the links back in the bar, and a panel
    // left open below it would then be the same five links twice.
    matchMedia('(min-width: 761px)').addEventListener('change', (ev) => {
      if (ev.matches) show(false);
    });
  }

  // Hairline appears only after the page scrolls. rAF-throttled so the scroll
  // listener never does layout work per event.
  const nav = document.querySelector<HTMLElement>('.nav');

  if (nav) {
    let ticking = false;

    const sync = () => {
      nav.toggleAttribute('data-top', window.scrollY < 8);
      ticking = false;
    };

    sync();
    addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(sync);
      },
      { passive: true }
    );
  }
</script>
