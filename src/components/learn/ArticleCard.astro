---
/**
 * One article, as a card on a section index or the landing page.
 *
 * Built on the same raised-surface treatment as `Card.astro` rather than
 * importing it, because a card that is entirely a link wants the anchor to be
 * the box — a link nested inside a card gives a large target that does nothing.
 */
interface Props {
  title: string;
  description: string;
  href: string;
  eyebrow?: string;
  /** Marks a row that exists only in English. */
  english?: false | string;
}

const { title, description, href, eyebrow, english = false } = Astro.props;
---

<a
  class="acard"
  href={href}
  lang={english ? 'en' : undefined}
  dir={english ? 'ltr' : undefined}
>
  {
    (eyebrow || english) && (
      <span class="acard__top">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        {english && <span class="acard__en">{english}</span>}
      </span>
    )
  }
  <h3 class="acard__title">{title}</h3>
  <p class="acard__desc">{description}</p>
</a>

<style>
  .acard {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding: var(--s-5);
    border: 1px solid var(--rule-soft);
    border-radius: var(--r-3);
    background-color: var(--paper-2);
    background-image: var(--sheen);
    color: var(--ink);
    text-decoration: none;
    transition:
      transform var(--dur) var(--ease-out),
      border-color var(--dur) ease,
      background-color var(--dur) ease;
  }

  .acard:active {
    transform: scale(0.98);
  }

  @media (hover: hover) and (pointer: fine) {
    .acard:hover {
      transform: translateY(-3px);
      border-color: var(--horn-deep);
      background-color: var(--paper-4);
    }
  }

  .acard__top {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  .acard__en {
    padding: 0 4px;
    border: 1px solid var(--rule);
    border-radius: var(--r-1);
    color: var(--ink-3);
    font-size: 10px;
    letter-spacing: 0.04em;
    unicode-bidi: isolate;
  }

  .acard__title {
    font-size: 1.25rem;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .acard__desc {
    color: var(--ink-2);
    font-size: var(--t-meta);
    line-height: 1.55;
  }
</style>
