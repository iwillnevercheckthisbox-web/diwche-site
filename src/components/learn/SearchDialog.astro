---
/**
 * The guide's search, as a command palette.
 *
 * `<dialog>` + `showModal()` rather than a hand-built overlay: the focus trap,
 * Esc-to-close, inertness of the page behind, and `::backdrop` all come with it
 * and all of them are things a hand-built one gets subtly wrong.
 *
 * The trigger is a real link to `/learn/all/`. With JavaScript it opens the
 * palette; without, it goes to the page that lists every article, where the
 * browser's own find-in-page does the searching. Search is the feature people
 * were promised, so it cannot be the one thing that needs a working bundle.
 */
import { dirFor, type Locale } from '../../lib/direction';
import { LEARN_UI } from '../../content/learn/ui';
import { learnHome } from '../../lib/learn';

interface Props {
  locale: Locale;
  /** The sidebar header wants a wide field; the nav wants an icon. */
  variant?: 'field' | 'icon';
}

const { locale, variant = 'field' } = Astro.props;
const ui = LEARN_UI[locale];
const dir = dirFor(locale);
const allHref = `${learnHome(locale)}all/`;
---

<a
  class:list={['lsearch', `lsearch--${variant}`]}
  href={allHref}
  data-learn-search-open
  data-index={`/learn-index.${locale}.json`}
  aria-keyshortcuts="Control+K Meta+K"
>
  <svg viewBox="0 0 20 20" aria-hidden="true" class="lsearch__icon">
    <circle cx="9" cy="9" r="5.4" /><path d="M13.2 13.2 17 17" stroke-linecap="round" />
  </svg>
  {variant === 'field' && <span class="lsearch__label">{ui.searchPlaceholder}</span>}
  {variant === 'field' && <kbd class="lsearch__kbd" aria-hidden="true">⌘K</kbd>}
  {variant === 'icon' && <span class="u-sr">{ui.searchPlaceholder}</span>}
</a>

<dialog class="lsd" data-learn-search dir={dir} aria-label={ui.searchPlaceholder}>
  <form method="dialog" class="lsd__form">
    <div class="lsd__head">
      <svg viewBox="0 0 20 20" aria-hidden="true" class="lsearch__icon">
        <circle cx="9" cy="9" r="5.4" /><path d="M13.2 13.2 17 17" stroke-linecap="round" />
      </svg>
      <input
        class="lsd__input"
        type="search"
        autocomplete="off"
        spellcheck="false"
        enterkeyhint="go"
        placeholder={ui.searchPlaceholder}
        aria-controls="lsd-list"
        aria-expanded="true"
        role="combobox"
        aria-autocomplete="list"
      />
      <button class="lsd__close" type="submit" value="close" aria-label={ui.searchClose}>Esc</button>
    </div>

    <div class="lsd__body">
      <p class="lsd__hint" data-lsd-hint data-starters={ui.searchStarters}>{ui.searchStarters}</p>
      <ul class="lsd__list" id="lsd-list" role="listbox" aria-label={ui.searchResults}></ul>
      <p class="lsd__empty" data-lsd-empty data-nomatch={ui.searchNothing} hidden></p>
    </div>

    <p class="lsd__foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> {ui.searchMove}</span>
      <span><kbd>↵</kbd> {ui.searchOpen}</span>
      <a href={allHref}>{ui.everything}</a>
    </p>
  </form>
</dialog>

<style>
  /* ---- The trigger -------------------------------------------------------- */

  .lsearch {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    text-decoration: none;
    color: var(--ink-3);
    transition:
      color var(--dur) ease,
      border-color var(--dur) ease;
  }

  .lsearch--field {
    width: 100%;
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--rule);
    border-radius: var(--r-2);
    background: var(--paper-2);
    background-image: var(--sheen);
    font-size: var(--t-meta);
  }

  .lsearch--icon {
    padding: var(--s-2);
    border-radius: var(--r-2);
  }

  .lsearch__icon {
    flex: none;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
  }

  .lsearch__label {
    flex: 1;
    text-align: start;
  }

  .lsearch__kbd,
  .lsd kbd {
    font: inherit;
    font-size: 11px;
    padding: 1px 5px;
    border: 1px solid var(--rule);
    border-radius: var(--r-1);
    color: var(--ink-3);
    /* A shortcut is always written left-to-right, even on a Persian page. */
    direction: ltr;
    unicode-bidi: isolate;
  }

  @media (hover: hover) and (pointer: fine) {
    .lsearch:hover {
      color: var(--ink);
      border-color: var(--horn-deep);
    }
  }

  .u-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  /* ---- The dialog --------------------------------------------------------- */

  .lsd {
    width: min(640px, calc(100vw - 2 * var(--s-4)));
    max-height: min(70vh, 560px);
    padding: 0;
    margin-block-start: 10vh;
    border: 1px solid var(--rule);
    border-radius: var(--r-3);
    background: var(--paper-2);
    background-image: var(--sheen);
    color: var(--ink);
    box-shadow: var(--shadow-frame-lift);
    overflow: hidden;
  }

  .lsd::backdrop {
    background: color-mix(in srgb, var(--paper) 72%, transparent);
    backdrop-filter: blur(3px);
  }

  /* DNA §5: entrances start at 0.96 and never at 0, transform and opacity only. */
  .lsd[open] {
    animation: lsd-in var(--dur) var(--ease-out);
  }

  @keyframes lsd-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lsd[open] {
      animation: none;
    }
  }

  .lsd__form {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }

  .lsd__head {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    border-block-end: 1px solid var(--rule);
    color: var(--ink-3);
  }

  .lsd__input {
    flex: 1;
    min-width: 0;
    font: inherit;
    color: var(--ink);
    background: none;
    border: none;
    outline: none;
  }

  /* The browser's own clear button is a second, unstyled control in the corner. */
  .lsd__input::-webkit-search-cancel-button {
    display: none;
  }

  .lsd__close {
    flex: none;
    font-size: 11px;
    padding: 2px 6px;
    border: 1px solid var(--rule);
    border-radius: var(--r-1);
    color: var(--ink-3);
  }

  .lsd__body {
    overflow-y: auto;
    padding: var(--s-2);
  }

  .lsd__hint,
  .lsd__empty {
    margin: 0;
    padding: var(--s-3) var(--s-3) var(--s-2);
    font-size: var(--t-meta);
    color: var(--ink-3);
  }

  .lsd__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lsd__group {
    padding: var(--s-4) var(--s-3) var(--s-2);
    font-size: var(--t-eyebrow);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  [lang='fa'] .lsd__group {
    text-transform: none;
    letter-spacing: 0;
  }

  .lsd__hit {
    display: block;
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-2);
    text-decoration: none;
    color: inherit;
  }

  .lsd__hit[aria-selected='true'] {
    background: var(--paper-4);
    /* The champagne edge, not a fill — DNA §2. */
    box-shadow: inset 2px 0 0 var(--horn);
  }

  .lsd__t {
    display: block;
    font-size: var(--t-meta);
    font-weight: 500;
  }

  .lsd__d {
    display: block;
    margin-block-start: 2px;
    font-size: var(--t-meta);
    line-height: 1.45;
    color: var(--ink-3);
    /* Two lines, then ellipsis: a result list is scanned, not read. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .lsd__hit :global(mark) {
    background: none;
    color: var(--horn);
    font-weight: 600;
  }

  .lsd__foot {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    margin: 0;
    padding: var(--s-2) var(--s-4);
    border-block-start: 1px solid var(--rule);
    font-size: var(--t-eyebrow);
    color: var(--ink-3);
  }

  .lsd__foot span {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
  }

  .lsd__foot a {
    margin-inline-start: auto;
    color: var(--ink-2);
  }

  @media (max-width: 600px) {
    .lsd__foot span {
      display: none;
    }
    .lsd__foot a {
      margin-inline-start: 0;
    }
  }
</style>

<script src="../../scripts/learn-search.ts"></script>
