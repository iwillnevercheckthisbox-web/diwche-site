---
/**
 * One line, set larger than body, with a champagne quote mark. Used for the
 * house lines — not for testimonials, because there are no customers to quote yet.
 */
interface Props {
  text: string;
  cite?: string;
}

const { text, cite } = Astro.props;
---

<figure class="quote">
  <span class="quote__mark" aria-hidden="true">&ldquo;</span>
  <div>
    <blockquote class="quote__text">{text}</blockquote>
    {cite && <figcaption class="quote__cite">{cite}</figcaption>}
  </div>
</figure>

<style>
  .quote {
    display: flex;
    align-items: flex-start;
    gap: var(--s-4);
    padding: var(--s-5) var(--s-6);
    background: var(--paper-2);
    background-image: var(--sheen);
    border: 1px solid var(--rule);
    border-radius: var(--r-3);
  }

  .quote__mark {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-variation-settings: var(--display-axes);
    font-size: 3rem;
    /* The glyph sits high in its box; pull it back down onto the first line. */
    line-height: 0.85;
    color: var(--horn);
  }

  .quote__text {
    font-size: 1.1875rem;
    line-height: 1.5;
  }

  .quote__cite {
    margin-top: var(--s-2);
    font-size: var(--t-meta);
    color: var(--ink-3);
  }
</style>
