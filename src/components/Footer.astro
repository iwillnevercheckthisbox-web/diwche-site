---
// A link with no `href` renders as plain text. That is deliberate: these pages
// do not exist yet, and a footer full of 404s is worse than an honest label.
// Give one an href the moment its page ships.
const groups = [
  {
    title: 'Product',
    links: [
      { href: '/#product', label: 'Everything it does' },
      { label: 'Topics' },
      { label: 'Reels Studio' },
      { label: 'Voice Lab' },
      { href: '/#pricing', label: 'Pricing' },
    ],
  },
  {
    title: 'Learn',
    links: [{ href: '/#faq', label: 'FAQ' }, { label: 'Guides' }, { label: 'About Diwche' }],
  },
  {
    title: 'Legal',
    links: [{ label: 'Privacy' }, { label: 'Terms' }],
  },
];

const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap foot__inner">
    <div class="foot__brand">
      <span class="foot__word">Diwche</span>
      <p class="foot__note">
        A studio that runs your Instagram accounts. Named after a small, tired imp.
      </p>
    </div>

    <div class="foot__cols">
      {
        groups.map((g) => (
          <div class="foot__col">
            <h3 class="eyebrow">{g.title}</h3>
            <ul>
              {g.links.map((l) => (
                <li>{l.href ? <a href={l.href}>{l.label}</a> : <span class="foot__soon">{l.label}</span>}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  <div class="wrap foot__base">
    <span>© {year} Diwche</span>
    <span>diwche.com</span>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--rule);
    padding-block: var(--s-9) var(--s-6);
    margin-top: var(--section-y);
  }

  .foot__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: var(--s-8);
  }

  .foot__word {
    font-family: var(--font-display);
    font-variation-settings: var(--display-axes);
    font-size: 2rem;
    letter-spacing: -0.04em;
  }

  .foot__note {
    margin-top: var(--s-3);
    max-width: 32ch;
    font-size: var(--t-meta);
    color: var(--ink-3);
    line-height: 1.6;
  }

  .foot__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-6);
  }

  .foot__col ul {
    list-style: none;
    padding: 0;
    margin-top: var(--s-4);
    display: grid;
    gap: var(--s-3);
  }

  .foot__col a {
    font-size: var(--t-meta);
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--dur) ease;
  }

  /* Not yet a page. Reads as a label, not a dead link. */
  .foot__soon {
    font-size: var(--t-meta);
    color: var(--ink-3);
  }

  @media (hover: hover) and (pointer: fine) {
    .foot__col a:hover {
      color: var(--ink);
    }
  }

  .foot__base {
    display: flex;
    justify-content: space-between;
    margin-top: var(--s-8);
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule);
    font-size: var(--t-meta);
    color: var(--ink-3);
  }

  @media (max-width: 860px) {
    .foot__inner {
      grid-template-columns: 1fr;
      gap: var(--s-7);
    }
  }

  @media (max-width: 520px) {
    .foot__cols {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
