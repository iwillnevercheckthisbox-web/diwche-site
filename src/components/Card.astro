---
/**
 * The raised surface: --paper-2, one hairline, 10px radius, a diagonal sheen.
 * No shadow — per DNA §4 shadows sit under framed screenshots only.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['card', className]}>
  <div class="card__sheen" aria-hidden="true"></div>
  <div class="card__body"><slot /></div>
</div>

<style>
  .card {
    position: relative;
    overflow: hidden;
    padding: var(--s-6);
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--r-3);
    transition:
      transform var(--dur) var(--ease-out),
      background-color var(--dur) ease;
  }

  .card__sheen {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: var(--sheen);
  }

  .card__body {
    position: relative;
  }

  @media (hover: hover) and (pointer: fine) {
    /* --paper-4 is the named hover for a raised surface (DNA §2) — the hairline
       stays put rather than changing colour under the pointer. */
    .card:hover {
      transform: translateY(-4px);
      background-color: var(--paper-4);
    }
  }
</style>
