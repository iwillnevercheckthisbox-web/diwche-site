---
import Base from '../../layouts/Base.astro';
import { allLocaleAlternates, metaDescription } from '../../lib/seo';
import LegalDoc from '../../components/LegalDoc.astro';
import { TERMS } from '../../content/legal';
import { HOME_DE } from '../../content/home';

/**
 * Terms of service. Meta's dashboard has a field for this URL too, so it
 * lives at a stable path in every language, like the privacy policy.
 */
const doc = TERMS['de'];
---

<Base
  alternates={allLocaleAlternates(Astro.url.pathname)}
  locale="de"
  copy={HOME_DE}
  title={`${doc.title} — Diwche`}
  description={metaDescription(doc.lead)}
>
  <LegalDoc doc={doc} />
</Base>
