---
import Base from '../../layouts/Base.astro';
import LegalDoc from '../../components/LegalDoc.astro';
import { PRIVACY } from '../../content/legal';
import { HOME_DE } from '../../content/home';

/**
 * The privacy policy.
 *
 * Also the URL Meta's dashboard points at, which is why it exists at a stable
 * path in every language rather than as one English page.
 */
const doc = PRIVACY['de'];
---

<Base
  locale="de"
  copy={HOME_DE}
  title={`${doc.title} — Diwche`}
  description={doc.lead}
>
  <LegalDoc doc={doc} />
</Base>
