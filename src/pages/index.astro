---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import TrustBar from '../components/TrustBar.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import QuoteCard from '../components/QuoteCard.astro';
import PricingCard from '../components/PricingCard.astro';
import Accordion from '../components/Accordion.astro';
import Stage from '../components/show/Stage.astro';

/**
 * The read is only offered when there is something behind it.
 *
 * The show talks to `/api/public/*`, which the backend does not serve yet.
 * Shipping the field before that exists would put a call to action on the live
 * site whose only outcome is an apology, so this defaults to off and the page
 * falls back to the CTAs it had. Build with `PUBLIC_READ=on` — and deploy the
 * backend first.
 */
const readEnabled = import.meta.env.PUBLIC_READ === 'on';

// The homepage: nav, hero, the show, the Meta band, the offer, three
// alternating pillar rows, a house line, reliability, pricing, FAQ, footer.
//
// The hero asks for one thing — a handle — and everything below it is the
// introduction that plays while that page is being read. With JS off, or before
// a handle is given, the static sections below are the whole page and nothing
// is missing.
//
// Prices are marked as placeholders because none have been decided — see DNA §7.

const capabilities = [
  { name: 'Ideas', text: 'Fresh topics every morning, each with a hook and a reason it matters today.' },
  { name: 'Insights', text: 'What actually worked — by source, persona, format and hour.' },
  { name: 'Story scan', text: 'Your feeds, filtered to the keywords you care about.' },
  { name: 'Peer read', text: 'The accounts you admire, read once and never posted to.' },
];

const paths = [
  {
    title: 'Already posting',
    text: 'He reads the account first and tells you what he found. If you want him on it after that, the trial is free and nothing is connected until you say so.',
  },
  {
    title: 'Not started yet',
    text: 'You have a subject and no page. He works out the angles worth building it on, and helps you build the account itself — identity, feeds, voice. Also free to start.',
  },
];

const trust = [
  {
    title: 'Per-account isolation',
    text: 'One account failing never touches the others. That is an architectural rule, not a setting.',
  },
  {
    title: 'It never posts twice',
    text: 'Every article is checked against what that account has already published before anything is made.',
  },
  {
    title: 'Optional review gate',
    text: 'Turn it on and nothing reaches Instagram until you have looked at it.',
  },
];

const tiers = [
  {
    name: 'Starter',
    description: 'One or two accounts, and you look at everything before it goes out.',
    features: ['A few accounts', 'Feeds, keywords and banners', 'Manual review on by default'],
  },
  {
    name: 'Studio',
    description: 'Reels, a recorded voice, and a schedule that runs without you.',
    features: ['More accounts', 'Reels and voice', 'Scheduled, unattended posting'],
    highlighted: true,
  },
  {
    name: 'Agency',
    description: 'Many accounts, each with its own feeds, keywords, voice and look.',
    features: ['Many accounts', 'Everything in Studio', 'Per-account templates'],
  },
];

const faqs = [
  {
    q: 'What counts as an account?',
    a: 'One connected Instagram account, with its own feeds, keywords, voice and schedule. Accounts do not share anything.',
  },
  {
    q: 'What do you need to read my page?',
    a: 'The handle, and nothing else. Everything read at that stage is what any visitor to your profile can see. To prove the page is yours you send a short code to us on Instagram — there is no password anywhere in this, and nothing is connected until you choose to connect it.',
  },
  {
    q: 'What language does it post in?',
    a: 'Whichever you set per account. Articles are translated before the caption is written, and the layout follows the direction of that language.',
  },
  {
    q: 'Is there a trial?',
    a: 'Yes. The read itself is free and needs nothing from you but a handle. If you want Diwche to act on what it found, the trial that follows is free too — the length is set when you are invited. Pricing after that is not settled.',
  },
  {
    q: 'What does "AI-driven" actually mean here?',
    a: 'AI does the labour: it reads the feeds, writes the draft, cuts the reel. What it posts and how it says it is shaped by patterns from real accounts that already grew this way, not a model guessing alone.',
  },
];
---

<Base
  title="Diwche — a manager for one Instagram account. Yours."
  description="Diwche runs one Instagram account at a time — reading your feeds, writing and designing the post, and putting it up on schedule, tuned to what has worked on accounts like yours."
>
  <!-- ================================================================== HERO -->
  <section class="hero">
    <div class="hero__wash" aria-hidden="true"></div>

    <div class="wrap hero__inner">
      <h1 class="hero__title">
        Some pages have a <span class="hero__title-accent">Diw</span>.
      </h1>
      <p class="lead hero__lead">
        He reads what you have made and what your audience answered. He remembers. Each morning he
        brings topics that are yours, not everyone's — then writes, shoots, captions and schedules,
        while you keep every word and frame.
      </p>

      <!-- One field. The whole page below is the answer to it. `novalidate`
           because the browser's own bubble cannot say this in his voice. -->
      {readEnabled && (
      <form class="handle" data-handle-form novalidate>
        <div class="handle__row">
          <div class="handle__field">
            <span class="handle__at" aria-hidden="true">@</span>
            <label class="handle__sr" for="handle">Your Instagram handle</label>
            <input
              class="handle__input"
              id="handle"
              name="handle"
              type="text"
              inputmode="text"
              autocomplete="off"
              autocapitalize="off"
              autocorrect="off"
              spellcheck="false"
              maxlength="30"
              placeholder="yourhandle"
            />
          </div>
          <button class="btn handle__go" type="submit">Let him look. It is free.</button>
        </div>
        <p class="handle__error" data-handle-error hidden></p>
        <p class="handle__note">
          No password, nothing to connect — he reads only what your profile already shows.
          <button class="handle__link" type="button" data-no-page>
            No page yet? Bring him an idea.
          </button>
        </p>
      </form>
      )}

      {!readEnabled && (
        <div class="hero__actions">
          <a class="btn" href="#pilot">See what he would do for your page</a>
          <a class="btn btn--quiet" href="#pricing">See pricing</a>
        </div>
      )}

      <figure class="hero__art">
        <Art name="hero-camera" loading="eager" />
      </figure>
    </div>
  </section>

  <!-- ================================================================== SHOW -->
  {readEnabled && <Stage />}

  <!-- ============================================================ META BAND -->
  <TrustBar />

  <!-- ================================================================= PILOT -->
  <section class="section pilot" id="pilot">
    <div class="wrap pilot__inner">
      <div class="reveal">
        <SectionHeader
          eyebrow="What it costs to find out"
          title="He reads your page before you pay him anything."
          lead="Give him a handle. He reads what is public, tells you what he found, and offers a free trial if you want him to act on it. Two ways in."
        />
      </div>

      <div class="pilot__art reveal" style="--reveal-delay: 60ms">
        <Art name="pilot-crowd" />
      </div>

      <ul class="pilot__paths reveal" style="--reveal-delay: 100ms">
        {
          paths.map((p, i) => (
            <li style={`--reveal-delay: ${i * 50}ms`}>
              <Card class="path">
                <h3 class="path__title">{p.title}</h3>
                <p class="path__text">{p.text}</p>
              </Card>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============================================================= PILLAR 01 -->
  <section class="section pillar" id="product">
    <div class="wrap pillar__row">
      <div class="pillar__copy reveal">
        <SectionHeader
          align="left"
          eyebrow="01 — Discover your next big topic"
          title="Find ideas worth posting without spending hours researching."
          lead="Enter any niche or topic, and Diwche handles the heavy lifting. It scans your feed, tracks accounts you admire, and delivers tailored suggestions alongside clear rules on what to post — and what to avoid. If you don't like the suggestions, you are never locked in: paste an article link you love, or steer the research in a new direction whenever you want."
        />
      </div>

      <div class="pillar__visual reveal" style="--reveal-delay: 60ms">
        <Art name="topics-thinking" />
      </div>
    </div>

    <ul class="wrap pillar__list">
      {
        capabilities.map((c, i) => (
          <li class="cap reveal" style={`--reveal-delay: ${i * 50}ms`}>
            <h3 class="cap__name">{c.name}</h3>
            <p class="cap__text">{c.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============================================================= PILLAR 02 -->
  <section class="section pillar">
    <div class="wrap pillar__row pillar__row--flip">
      <div class="pillar__copy reveal">
        <SectionHeader
          align="left"
          eyebrow="02 — Create it your way"
          title="Turn any topic into a finished post, carousel or reel."
          lead="Take a topic Diwche found, pull in one of your tracked feeds, or start from scratch with your own prompt. Diwche writes and designs single posts, carousels, reels and stories, all matched to the voice and look you set for that account."
        />
      </div>

      <div class="pillar__visual reveal" style="--reveal-delay: 60ms">
        <Art name="create-writing" />
      </div>
    </div>
  </section>

  <!-- ============================================================= PILLAR 03 -->
  <section class="section pillar">
    <div class="wrap pillar__row">
      <div class="pillar__copy reveal">
        <SectionHeader
          align="left"
          eyebrow="03 — Publish and schedule"
          title="Connect your account once and let Diwche handle the timing."
          lead="Link your Instagram securely through Facebook, with no token to paste. Publish immediately, or schedule for peak engagement times; Diwche keeps the connection alive in the background, so your queue stays automated without dropping off."
        />
      </div>

      <div class="pillar__visual reveal" style="--reveal-delay: 60ms">
        <Art name="publish-mailbox" />
      </div>
    </div>
  </section>

  <!-- =============================================================== APPROACH -->
  <section class="section" id="approach">
    <div class="wrap reveal">
      <SectionHeader
        align="left"
        eyebrow="How it thinks"
        title="AI does the labour. The judgment is borrowed from people who already do this."
        lead="Diwche does not write from nothing and hope. What it posts, how it says it and when it sends it are shaped by patterns pulled from real accounts that already grew this way. AI reads the feeds, writes the draft and cuts the reel — it does not decide your strategy alone."
      />
    </div>
  </section>

  <!-- ================================================================= QUOTE -->
  <div class="wrap quote-slot reveal">
    <QuoteCard
      text="It reads 40 feeds an hour and throws away the 38 stories that aren't yours."
    />
  </div>

  <!-- =========================================================== RELIABILITY -->
  <section class="section" id="reliability">
    <div class="wrap">
      <div class="reveal">
        <SectionHeader
          align="left"
          eyebrow="Reliability"
          title="Built to fail safely"
          lead="Most of what Diwche does happens while nobody is watching. So the interesting question is what it does when something goes wrong."
        />
      </div>

      <ul class="grid-3">
        {
          trust.map((t, i) => (
            <li class="reveal" style={`--reveal-delay: ${i * 50}ms`}>
              <Card class="trust">
                <h3 class="trust__title">{t.title}</h3>
                <p class="trust__text">{t.text}</p>
              </Card>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- =============================================================== PRICING -->
  <section class="section" id="pricing">
    <div class="wrap">
      <div class="reveal">
        <SectionHeader
          eyebrow="Pricing"
          title="Placeholder figures, real tiers"
          lead="No prices have been decided yet. The shape of the tiers has. Every one of them ends in a demo, not a checkout."
        />
      </div>

      <ul class="grid-3">
        {
          tiers.map((t, i) => (
            <li class="reveal" style={`--reveal-delay: ${i * 50}ms`}>
              <PricingCard
                name={t.name}
                description={t.description}
                features={t.features}
                highlighted={t.highlighted}
              />
            </li>
          ))
        }
      </ul>

      <p class="pricing__note">Terms are not final. Neither is the number of accounts in a tier.</p>
    </div>
  </section>

  <!-- =================================================================== FAQ -->
  <section class="section faq" id="faq">
    <div class="wrap faq__inner reveal">
      <SectionHeader
        align="left"
        eyebrow="FAQ"
        title="A few questions"
        lead="Anything not here, ask at the demo."
      />
      <Accordion items={faqs} class="faq__list" />
    </div>
  </section>
</Base>

<style>
  /* ---- Hero -------------------------------------------------------------- */

  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3rem, 1rem + 8vw, 6.5rem) clamp(2rem, 1rem + 5vw, 5rem);
    text-align: center;
  }

  /* The hero's own light source, over the page's ambient wash: sapphire from the
     top left, champagne from the top right, both falling off well before the fold. */
  .hero__wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      radial-gradient(56rem 34rem at 8% 0%, var(--glow-1), transparent 60%),
      radial-gradient(56rem 34rem at 92% 0%, var(--glow-2), transparent 60%);
  }

  .hero__title {
    margin-inline: auto;
    font-size: var(--t-hero);
    line-height: 1.06;
    letter-spacing: -0.035em;
    max-width: 18ch;
  }

  /* The second line carries the one accent in the hero. Periwinkle rather than
     flat sapphire: --accent on near-black is a colour you have to lean in to
     read, and this line is half the headline. */
  .hero__title-accent {
    color: var(--accent-soft);
  }

  .hero__lead {
    margin-top: var(--s-5);
    margin-inline: auto;
    max-width: 56ch;
  }

  /* The fallback pair, shown only while the read is switched off. */
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  /* ---- The one field ------------------------------------------------------
     This is the only input on the site, so it carries more weight than a form
     control usually would: it is sized like the lead paragraph, not like a
     settings field, and the button next to it says what happens rather than
     naming an action. */

  .handle {
    margin-top: var(--s-6);
    display: grid;
    gap: var(--s-3);
    justify-items: center;
  }

  .handle__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
    width: 100%;
  }

  .handle__field {
    display: flex;
    align-items: center;
    gap: 0;
    min-width: min(20rem, 100%);
    padding-inline: var(--s-4);
    background: var(--paper-2);
    background-image: var(--sheen);
    border: 1px solid var(--rule);
    border-radius: var(--r-3);
    transition: border-color var(--dur) ease;
  }

  .handle__field:focus-within {
    border-color: var(--accent-soft);
  }

  .handle__at {
    color: var(--ink-3);
    font-size: var(--t-lead);
    line-height: 1;
  }

  .handle__input {
    flex: 1;
    min-width: 0;
    padding: 0.85rem 0.25rem;
    background: none;
    border: none;
    color: var(--ink);
    font: inherit;
    font-size: var(--t-lead);
    letter-spacing: -0.01em;
  }

  .handle__input:focus {
    outline: none;
  }

  .handle__input::placeholder {
    color: var(--ink-3);
  }

  .handle__go {
    flex: none;
  }

  .handle__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .handle__error {
    font-size: var(--t-meta);
    color: var(--alarm);
  }

  .handle__note {
    max-width: 46ch;
    font-size: var(--t-meta);
    color: var(--ink-3);
    text-align: center;
  }

  /* A button that reads as a link: it is a second route into the same show, not
     a second call to action competing with the first. */
  .handle__link {
    padding: 0;
    color: var(--ink-2);
    font: inherit;
    font-size: var(--t-meta);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.2em;
    transition: color var(--dur) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .handle__link:hover {
      color: var(--ink);
      text-decoration-color: var(--horn);
    }
  }

  @media (max-width: 560px) {
    .handle__row {
      flex-direction: column;
      align-items: stretch;
    }

    .handle__go {
      justify-content: center;
    }
  }

  /* Once the show starts the drawing has done its job, and it is the only thing
     between the field and the stage. Taking it out of the flow closes that gap
     so the first scene lands where the eye already is. */
  :global(body[data-showing]) .hero__art {
    display: none;
  }

  .hero__art {
    /* `width: 100%` is load-bearing: without it the figure shrink-to-fits its
       content box instead of taking the column. */
    width: 100%;
    max-width: 460px;
    margin: var(--s-8) auto 0;
  }

  /* ---- Pilot ------------------------------------------------------------- */

  .pilot__inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  /* The drawing is a crowd, so it needs less width than a single figure would to
     read at the same scale. */
  .pilot__art {
    width: 100%;
    max-width: 340px;
    margin-top: var(--s-7);
  }

  .pilot__paths {
    list-style: none;
    padding: 0;
    margin-top: var(--s-8);
    width: 100%;
    max-width: 46rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5);
    text-align: left;
  }

  .path__title {
    font-size: 1.375rem;
  }

  .path__text {
    margin-top: var(--s-3);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--ink-2);
  }

  @media (max-width: 640px) {
    .pilot__paths {
      grid-template-columns: 1fr;
    }
  }

  /* ---- Pillars ----------------------------------------------------------- */
  /* Two columns, alternating side. The row is the rhythm of the whole page.
     Half the section rhythm each, so two stacked pillars add up to one gap
     rather than two — otherwise the page reads as a list of lonely rows. */

  .pillar {
    padding-block: calc(var(--section-y) / 2);
  }

  .pillar__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 4vw, 3.5rem);
    align-items: center;
  }

  .pillar__row--flip .pillar__copy {
    order: 2;
  }

  .pillar__visual {
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  /* No frame: every drawing is cut out and floats on the page ground. */
  .pillar__visual :global(.art) {
    max-width: 360px;
  }

  .pillar__list {
    list-style: none;
    padding-inline: var(--s-5);
    margin-top: var(--s-8);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-6);
  }

  .cap {
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
  }

  .cap__name {
    font-size: 1.25rem;
    letter-spacing: -0.03em;
  }

  .cap__text {
    margin-top: var(--s-2);
    font-size: var(--t-meta);
    line-height: 1.6;
    color: var(--ink-2);
  }

  /* ---- Quote ------------------------------------------------------------- */

  .quote-slot {
    max-width: 46rem;
    margin-block: calc(var(--section-y) / 2);
  }

  /* ---- Three-up rows (reliability, pricing) ------------------------------ */

  .grid-3 {
    list-style: none;
    padding: 0;
    margin-top: var(--s-8);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-5);
  }

  .grid-3 > li {
    display: flex;
  }

  .grid-3 > li > :global(*) {
    width: 100%;
  }

  .trust__title {
    font-size: 1.375rem;
  }

  .trust__text {
    margin-top: var(--s-3);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .pricing__note {
    margin-top: var(--s-6);
    text-align: center;
    font-size: var(--t-meta);
    color: var(--ink-3);
  }

  /* ---- FAQ --------------------------------------------------------------- */

  /* The footer brings its own top margin; a full section pad here would stack. */
  .faq {
    padding-bottom: 0;
  }

  .faq__inner {
    max-width: 44rem;
  }

  .faq__list {
    margin-top: var(--s-6);
  }

  /* ---- Responsive -------------------------------------------------------- */

  @media (max-width: 900px) {
    .pillar__row {
      grid-template-columns: 1fr;
      gap: var(--s-7);
    }

    /* On one column the picture always follows its copy, flipped row or not. */
    .pillar__row--flip .pillar__copy {
      order: 0;
    }

    .pillar__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .grid-3 {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .pillar__list {
      grid-template-columns: 1fr;
      gap: var(--s-5);
    }
  }
</style>

<script>
  // The show is the only scripted thing on the page. It does nothing at all
  // until a handle is submitted, and the static sections stand on their own
  // if it never loads.
  import '../scripts/show';
</script>
