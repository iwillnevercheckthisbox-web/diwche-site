---
import Bare from '../layouts/Bare.astro';
import Funnel from '../components/funnel/Funnel.astro';
import { EN } from '../components/funnel/copy.en';

/**
 * The funnel lives on its own page, with no nav and no footer.
 *
 * It always renders, even before the backend serves `/api/public/*`. Nothing
 * links here while PUBLIC_READ is unset and the page is `noindex`, so the only
 * people who arrive are the ones who typed the URL — which is exactly who needs
 * to walk it while it is being built. What the flag actually controls is the
 * hero CTA on the homepage, so no visitor is ever sent into a walk that cannot
 * finish, and the banner below, so nobody who does arrive is misled about it.
 */
const connected = import.meta.env.PUBLIC_READ === 'on';
---

<Bare locale="en" title={EN.meta.title} description={EN.meta.description}>
  <Funnel connected={connected} copy={EN} />

  <script>import '../scripts/funnel';</script>
</Bare>
