---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/geist';
// Neither Latin face has Persian coverage; without this the Farsi site falls
// through to whatever the OS substitutes.
import '@fontsource-variable/vazirmatn';
import '../styles/tokens.css';
import '../styles/base.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { DEFAULT_LOCALE, LOCALES, dirFor, type Locale } from '../lib/direction';
import { humanCheckLabel } from '../lib/humanCheck';
import { OG_LOCALE, graph, ogImageFor } from '../lib/seo';
import { HOME_EN, type HomeCopy } from '../content/home';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  /** Nav and footer are chrome: they speak whatever the page speaks. */
  copy?: HomeCopy;
  /**
   * Whether this page has to prove its visitor is a person.
   *
   * Opt-in, and it must be opted into by every page that posts to a guarded endpoint.
   * The consent page did not, for its whole life: it called for a token, there was no
   * key on the document and no Cloudflare script on the page, so it posted nothing and
   * the backend refused it with "he could not tell that you were a person". Not one
   * consent was ever recorded. It is a prop rather than something every page gets
   * because loading a third party on pages that do not need it is a cost paid by
   * readers who were only ever going to read.
   */
  turnstile?: boolean;
  /**
   * Where this same page lives in the other languages.
   *
   * Only the locales that actually have it. The guide is translated article by
   * article, so a blanket "every page exists in every language" alternate — which
   * is what a sitemap integration would emit — would advertise URLs that 404.
   */
  alternates?: { locale: Locale; href: string }[];
  /**
   * The social card image, as an absolute path.
   *
   * The site declared `summary_large_image` since it launched and never set one,
   * so every share was a bare text card. A page still names its own where it has
   * a better picture than the brand card — the default is a floor, not a ceiling.
   */
  image?: string;
  /**
   * Keep this page out of search results.
   *
   * For pages that only mean something walked into: the funnel says this in
   * Bare.astro, and the two post-action pages say it here. Being absent from the
   * sitemap is not the same claim — a sitemap says "here is what to crawl", not
   * "do not crawl the rest", so anything linked from anywhere was still eligible.
   */
  noindex?: boolean;
  /**
   * Structured data this page adds on top of the site-wide Organization and
   * WebSite nodes, which every page emits. See src/lib/seo.ts for the rule about
   * only claiming what the page says out loud.
   */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  locale = DEFAULT_LOCALE,
  copy = HOME_EN,
  turnstile = false,
  alternates = [],
  image,
  noindex = false,
  schema = [],
} = Astro.props;

// Nothing third-party is loaded without a key, so an unconfigured build is the page
// exactly as it was.
const turnstileKey = turnstile ? (import.meta.env.PUBLIC_TURNSTILE_KEY ?? '') : '';
const canonical = new URL(Astro.url.pathname, Astro.site);
// Direction follows the content language, resolved in one place.
const dir = dirFor(locale);
// A page's own picture wins; otherwise the brand card in this page's language.
const card = new URL(image ?? ogImageFor(locale), Astro.site);
const jsonLd = graph(locale, schema);
---

<!doctype html>
<html
  lang={locale}
  dir={dir}
  data-turnstile-key={turnstileKey || undefined}
  data-turnstile-label={turnstileKey ? humanCheckLabel(locale) : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {
      alternates.map((a) => (
        <link rel="alternate" hreflang={a.locale} href={new URL(a.href, Astro.site)} />
      ))
    }
    {
      alternates.length > 0 && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(alternates.find((a) => a.locale === DEFAULT_LOCALE)?.href ?? Astro.url.pathname, Astro.site)}
        />
      )
    }
    <!-- Two entries, so the browser chrome matches the room the reader lands in.
         The toggle rewrites these when it switches. -->
    <meta name="theme-color" content="#05070c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f6f2" media="(prefers-color-scheme: light)" />

    {
      turnstileKey && (
        <script
          is:inline
          async
          defer
          src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
        />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Diwche" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <!-- Underscored tags, which is what Open Graph wants — not the BCP-47 ones
         `lang` carries. The alternates are the languages this page is actually
         written in, so they stay in step with the hreflang links above. -->
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {
      LOCALES.filter((l) => l !== locale && alternates.some((a) => a.locale === l)).map((l) => (
        <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
      ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Unconditional. It used to be `{image && …}` with nothing ever passing
         `image`, which is how a `summary_large_image` card shipped for a year
         with no image in it. The dimensions let a platform reserve the space
         before the file arrives. -->
    <meta property="og:image" content={card} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:image" content={card} />

    <!-- One graph rather than a tag per node: `@id` references only resolve
         inside one, and it is the shape Google's own docs ask for. -->
    <script type="application/ld+json" is:inline set:html={jsonLd} />

    <!-- Cut from the mark itself by `npm run art:build`. The hand-drawn SVG that
         used to sit here was a second, thinner pair of horns that read as goggles
         in a 16px tab — one drawing, one icon, no drift. -->
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/icon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/brand/icon-512.png" />
    <link rel="apple-touch-icon" href="/brand/icon-180.png" />

    <!-- `.js` gates the scroll-reveal styles, so content is never hidden when
         scripts fail. Resolving the theme has to happen here too — before first
         paint — or the page flashes the wrong room. Stored choice wins, then the
         system preference, then dark, which is the identity. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');

        var theme = 'dark';
        try {
          var saved = localStorage.getItem('diwche-theme');
          if (saved === 'light' || saved === 'dark') {
            theme = saved;
          } else if (matchMedia('(prefers-color-scheme: light)').matches) {
            theme = 'light';
          }
        } catch (e) {
          /* Private mode can throw on read. Dark is the correct fallback. */
        }

        root.dataset.theme = theme;
      })();
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav copy={copy} locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer copy={copy} />

    <script>
      // Scroll reveal. Fires once per element, then stops observing.
      const targets = document.querySelectorAll('.reveal');

      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && targets.length) {
        const io = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              obs.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -80px 0px' }
        );
        for (const t of targets) io.observe(t);
      } else {
        for (const t of targets) t.classList.add('is-in');
      }
    </script>
  </body>
</html>

<style>
  /*
   * Parked off-screen by clipping, not by a negative offset.
   *
   * `left: -9999px` is invisible in a left-to-right page because browsers do
   * not scroll past the origin — but in a right-to-left one that same offset
   * lands off the *visible* edge and gives the whole site a horizontal
   * scrollbar. Clipping has no side and works in both.
   */
  .skip {
    position: absolute;
    top: 0;
    inset-inline-start: 0;
    z-index: 100;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    padding: var(--s-3) var(--s-4);
    background: var(--ink);
    color: var(--paper-2);
    text-decoration: none;
  }

  .skip:focus {
    width: auto;
    height: auto;
    overflow: visible;
    clip-path: none;
    inset-inline-start: var(--s-4);
    top: var(--s-4);
  }
</style>
