---
/**
 * The layout for the funnel: no nav, no footer, no way out but forward.
 *
 * A funnel that carries the site's navigation invites the reader to leave it,
 * so this shares Base.astro's head — fonts, theme resolution before first
 * paint, meta — and nothing else. The page owns the whole viewport.
 */
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/geist';
// Persian has no coverage in either Latin face, so without this the Farsi
// funnel falls through to whatever the operating system substitutes — a
// different typeface on every machine. Self-hosted like the other two:
// astro.config.mjs forbids external asset hosts, so the app's Google Fonts
// link is not an option here.
import '@fontsource-variable/vazirmatn';
import '../styles/tokens.css';
import '../styles/base.css';
import { DEFAULT_LOCALE, dirFor, type Locale } from '../lib/direction';
import { humanCheckLabel } from '../lib/humanCheck';
import { OG_LOCALE, ogImageFor } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
}

const { title, description, locale = DEFAULT_LOCALE } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Direction follows the content language, resolved in one place — never
// hardcoded here. See src/lib/direction.ts.
const dir = dirFor(locale);
// The brand card in this page's language. Bare pages are shared in chat far more often than
// they are found in search — which is the whole of Trello #379 item 8's second half.
const card = new URL(ogImageFor(locale), Astro.site);

/**
 * Proof-of-human, when there is a key for it.
 *
 * Nothing third-party is loaded without one, so an unconfigured build is the
 * page exactly as it was. The backend decides whether a missing token is
 * acceptable — this only mints one.
 */
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_KEY ?? '';
---

<!doctype html>
<html
  lang={locale}
  dir={dir}
  data-turnstile-key={turnstileKey || undefined}
  data-turnstile-label={turnstileKey ? humanCheckLabel(locale) : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- The funnel is not a page anyone should land on from a search result;
         it only means anything walked through from the start. -->
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#05070c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f6f2" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/icon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/brand/icon-512.png" />
    <link rel="apple-touch-icon" href="/brand/icon-180.png" />

    <!-- Open Graph, which this layout carried none of.
         `noindex` above keeps these pages out of search, and that is right — but it says nothing
         about a link pasted into Telegram, WhatsApp or Slack, and those are exactly how /read and
         a bio page travel. With no tags at all the scraper falls back to whatever it can find,
         which is how a shared link came back wearing an old title belonging to somebody's
         Instagram account (#379 item 8). -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Diwche" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={card} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:image" content={card} />

    {
      turnstileKey && (
        <script
          is:inline
          async
          defer
          src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
        />
      )
    }

    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var theme = 'dark';
        try {
          var saved = localStorage.getItem('diwche-theme');
          if (saved === 'light' || saved === 'dark') {
            theme = saved;
          } else if (matchMedia('(prefers-color-scheme: light)').matches) {
            theme = 'light';
          }
        } catch (e) {
          /* Private mode can throw on read. Dark is the correct fallback. */
        }
        root.dataset.theme = theme;
      })();
    </script>
  </head>

  <body class="bare">
    <slot />
  </body>
</html>

<style is:global>
  /* The funnel fills the window and never scrolls the document: each screen
     scrolls inside itself if it has to, so the progress bar and the back arrow
     stay where they were put. `dvh` rather than `vh` so the mobile URL bar
     collapsing does not cut a screen off at the bottom. */
  body.bare {
    min-height: 100dvh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
</style>
