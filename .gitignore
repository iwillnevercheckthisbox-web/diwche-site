node_modules/
dist/
.astro/
.DS_Store

# Mascot payload is copied from mascot/dist by `npm run mascot:sync`. It is generated,
# not authored — the source of truth is mascot/ — but it IS committed: mascot/dist is
# ignored (22MB of authoring output, and rebuilding it needs the Python pipeline), so
# this 770KB slice is the only copy CI ever sees. Re-run mascot:sync and commit the
# result whenever the art changes.

# Screenshots are captured from the running app by `npm run shoot`.
public/shots/*
# ...except the hand-drawn placeholders, which contain no real data.
!public/shots/_placeholder-*.svg
# ...and the captures from the e2e stack, which also contain no real data: that
# stack is disposable, its account is invented, and its numbers are generated by
# scripts/shots-seed.sql. Nothing in them belongs to a person, which is the
# condition the original rule was protecting. A capture from anywhere else still
# must not be committed.
!public/shots/ideas.png
!public/shots/performance.png
!public/shots/activity.png
