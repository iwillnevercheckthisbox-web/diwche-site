# The public read is rate limited here rather than in the app: a request that
# never reaches Java costs nothing, and this is the only door to it.
#
# Two things about the shape below were learned from a broken read in
# production, and neither is obvious from the outside.
#
# 1. Who the visitor is. Everything arrives through the Cloudflare tunnel, which
#    runs beside this container, so $remote_addr is 172.17.0.1 for every visitor
#    on earth — one shared bucket, and whoever walks the funnel first spends
#    everybody else's allowance for the minute. The access log says so plainly:
#    every line is `172.17.0.1 ... "77.119.254.130"`, the real address only in
#    the forwarded field. Cloudflare sets CF-Connecting-IP at its own edge and
#    overwrites whatever the client sent, so on this path it is the address;
#    $binary_remote_addr remains the fallback for a deployment with no tunnel in
#    front of it. Nothing here is the last line of defence — the app keeps its
#    own per-address hourly, poll and daily allowances behind this door.
#
# 2. Starting a read and watching one are not the same request. The progress
#    stream reconnects, and its polling fallback asks every 800–1200ms, so one
#    genuine visitor whose stream drops makes five requests in six seconds.
#    Against 6r/m that is an immediate 429, which the site reads as the daily
#    cap and shows as "he has read all he can today" — a working read killed by
#    its own progress bar. So watching gets its own generous zone and the strict
#    one is left to the calls that actually start work.
map $http_cf_connecting_ip $visitor {
    default $http_cf_connecting_ip;
    ""      $binary_remote_addr;
}

# Watching something already running: GET /audit/{id}, its /events stream and
# /topics, and GET /proof/{id}. Everything else under the prefix — POST /audit,
# /idea, /proof, /lead, /audit/{id}/lead — is starting something, and pays the
# strict rate. $uri rather than $request_uri so a query string cannot dodge the
# anchor at the end of the pattern.
map $uri $publicread_key {
    default                                                 $visitor;
    "~^/api/public/(audit|proof)/[^/]+(/(events|topics))?$" "";
}
map $uri $publicwatch_key {
    default                                                 "";
    "~^/api/public/(audit|proof)/[^/]+(/(events|topics))?$" $visitor;
}

# An empty key is not accounted, so each request is only ever counted in one of
# these — the map above decides which.
limit_req_zone $publicread_key  zone=publicread:10m  rate=6r/m;
limit_req_zone $publicwatch_key zone=publicwatch:10m rate=120r/m;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Behind the Cloudflare tunnel; the edge terminates TLS, we still compress.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/manifest+json;

    include conf.d/security-headers.conf;

    # The public page an account hands out, and its images.
    #
    # A longer prefix than /api/public/ below, so nginx picks this one for it whatever the order
    # in this file. It needs its own block for one reason: the read's limiter is six a minute,
    # and one visit to a bio page is a dozen requests — the page, an avatar and nine thumbnails.
    # Under the read's zone the first visitor would be refused halfway down their own page.
    #
    # The read's costs are not here either. Nothing under this prefix calls a model, scrapes
    # anything, or spends a cap; it reads rows this account already owns and proxies images we
    # already have the address of. The watch zone is the right size for it.
    location /api/public/reports/ {
        limit_req zone=publicwatch burst=20 nodelay;
        limit_req_status 429;

        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Origin "";
        proxy_set_header X-Diwche-Read "${READ_GATE}";
        proxy_read_timeout 30s;

        include conf.d/security-headers.conf;
    }

    location /api/public/bio/ {
        limit_req zone=publicwatch burst=40 nodelay;
        limit_req_status 429;

        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Same reasoning as the block below: the request is same-origin, but the backend sees a
        # proxied host and would classify a browser's Origin header as cross-origin.
        proxy_set_header Origin "";
        proxy_set_header X-Diwche-Read "${READ_GATE}";

        # The link redirect must never be cached by anything in between: the count is taken on
        # the way through, and a cached 302 is a click nobody sees.
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;

        include conf.d/security-headers.conf;
    }

    # The one path on this site that is not a static file.
    #
    # Proxying it here is what keeps the browser tokenless: the call is
    # same-origin, so there is no CORS surface and no key in the front end, and
    # nothing behind Keycloak is exposed — only this prefix is forwarded, and the
    # backend treats it as public and guards it with proof-of-human, a per-handle
    # cache and a daily spend cap.
    location /api/public/ {
        limit_req zone=publicread burst=5 nodelay;
        limit_req zone=publicwatch burst=30 nodelay;
        limit_req_status 429;

        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Drop the browser's Origin before forwarding.
        #
        # This request IS same-origin — diwche.com asking diwche.com — but a POST carries an
        # Origin header regardless, and the backend sees the proxied request as
        # http://host:5556 rather than https://diwche.com. Those do not match, so Spring
        # classifies it as cross-origin and answers 403 "Invalid CORS request".
        #
        # Blanking the header makes it what it actually is: a request with no Origin, which
        # is not a CORS request at all. The alternative — adding diwche.com to the app's CORS
        # allowlist — would widen that allowlist across every /api/** endpoint to fix one
        # prefix, so it is done here where the same-origin illusion is created.
        #
        # Removing this line breaks every browser call to the public read. curl will not
        # notice, because curl sends no Origin.
        proxy_set_header Origin "";

        # The one credential in this whole flow, and the browser never sees it.
        #
        # Set here, server side, on the way to the backend — not in the page, not in
        # any JavaScript, not in a response header. The backend refuses /api/public/*
        # without it, which means the read cannot be called on the backend's own
        # hostname at all: this proxy is the only door, and it is the door with the
        # rate limiter on it.
        #
        # Substituted at container start by nginx's own entrypoint from READ_GATE in
        # the environment. Empty here means the backend must also be unconfigured, or
        # every read is refused.
        proxy_set_header X-Diwche-Read "${READ_GATE}";

        # The read streams its progress, so nothing may sit in a buffer waiting
        # to be flushed, and the read itself can outlast a default timeout.
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Connection '';
        chunked_transfer_encoding off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        include conf.d/security-headers.conf;
    }

    # The page an account hands out: diwche.com/@handle.
    #
    # One built file serves every handle. The site is static (no adapter, on purpose), so a page
    # whose content depends on the handle cannot be prerendered — this maps the address onto the
    # shell and the shell's own script reads the handle back out of the path. The regex is the
    # same character class the backend validates a slug against, so an address that could never
    # exist 404s here rather than loading a shell that will only fail.
    # Quoted, because nginx reads an unquoted { as the start of a block and refuses to start at
    # all with "unknown directive" — a regex with a repetition count has to be a string.
    location ~ "^/@[a-z0-9._]{2,30}/?$" {
        try_files /bio/index.html =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        include conf.d/security-headers.conf;
    }

    # A shared report: diwche.com/r/{token}.
    #
    # Same shape as the /@handle rule below it — one built shell for every token, because the
    # site is static and the token is only known at request time. The character class is the
    # URL-safe base64 the backend mints, so a link that could never exist 404s here.
    # Quoted for the same reason as the /@handle rule below: an unquoted { is a block to nginx.
    location ~ "^/r/[A-Za-z0-9_-]{8,64}/?$" {
        try_files /r/index.html =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        include conf.d/security-headers.conf;
    }

    # Uptime Kuma and the deploy script poke this; it must not touch the app.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Astro builds with format: 'directory' — /about is /about/index.html on
    # disk. No SPA fallback: a wrong URL is a genuine 404, not a blank shell.
    #
    # This also carries the no-cache header for the HTML shell, and it has to be
    # here rather than in a `~* \.html$` block: the shell is requested as `/`
    # and `/about/`, which never end in .html, so a regex on the extension would
    # have missed every page on the site. The hashed assets that must be cached
    # live under the prefix locations below, which win over this one.
    location / {
        try_files $uri $uri/index.html $uri/ =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        include conf.d/security-headers.conf;
    }

    # Hashed by the build, so they can never go stale.
    location /_astro/ {
        include conf.d/security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # The mascot payload is NOT content-hashed — the files keep their names
    # across deploys, so they must revalidate rather than pin for a year.
    location /mascot/ {
        include conf.d/security-headers.conf;
        expires 1h;
        add_header Cache-Control "public, must-revalidate";
    }

    location /shots/ {
        include conf.d/security-headers.conf;
        expires 1h;
        add_header Cache-Control "public, must-revalidate";
    }

    # The guide, in every language, and its three search indexes: gone (#379).
    #
    # The build no longer emits any of it, so `location /` would 404 these on its
    # own. This says it out loud instead, so a stale file left in the image — or
    # routes un-parked by mistake — cannot put the guide back on the site. When the
    # guide returns, delete this block and restore the /learn-index. cache rule
    # from git history. `(/|-index\.|$)` and not a bare prefix, so a future
    # /learning page is not swallowed by it.
    location ~ "^/(fa/|de/)?learn(/|-index\.|$)" {
        include conf.d/security-headers.conf;
        return 404;
    }
}
